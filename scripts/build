#!/bin/env bash

# Regenerate the tool themes under extras/ (run from the repo root).
# No argument does every tool; one argument does just that tool:
#   scripts/build            # all
#   scripts/build fzf        # only extras/fzf
#
# The rtp points at the repo itself, not a plugin manager's copy — the old
# ~/.local/share/nvim/lazy path stopped existing and silently generated
# nothing. lvim-utils rides along (config.lua requires it) from its sibling
# checkout next to this repo (e.g. ~/development/lua/lvim-utils).

REPO=$(cd "$(dirname "$0")/.." && pwd)
UTILS=$(cd "$REPO/.." && pwd)/lvim-utils
ONLY=${1:+"'$1'"}

nvim --headless -u NONE \
    -c "set rtp+=$REPO,$UTILS" \
    -c "lua require('lvim-colorscheme.extra').generate_themes($ONLY)" +qa
