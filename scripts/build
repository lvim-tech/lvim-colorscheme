#!/bin/env bash

# Regenerate every tool theme under extras/ (run from the repo root).
# Equivalent to :lua require("lvim-colorscheme.extra").generate_themes()

nvim --headless -u NONE -c "set rtp+=~/.local/share/nvim/lazy/lvim-colorscheme" -c "lua require('lvim-colorscheme.extra').generate_themes()" +qa
