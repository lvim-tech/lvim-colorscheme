#!/bin/env bash

# Regenerate the gowall palette config under extras/gowall/ (run from the repo root).
# Equivalent to :lua require("lvim-colorscheme.extra").generate_gowall()

nvim --headless -u NONE -c "set rtp+=~/.local/share/nvim/lazy/lvim-colorscheme" -c "lua require('lvim-colorscheme.extra').generate_gowall()" +qa
