#!/bin/env bash

# Regenerate the gowall palette file under extras/gowall/ (run from the repo root).
# Equivalent to :lua require("lvim-colorscheme.extra").generate_gowall()
#
# Same rtp story as scripts/build: the repo itself plus lvim-utils.

REPO=$(cd "$(dirname "$0")/.." && pwd)

nvim --headless -u NONE \
    -c "set rtp+=$REPO,$HOME/lvim-tech/lvim-utils" \
    -c "lua require('lvim-colorscheme.extra').generate_gowall()" +qa
