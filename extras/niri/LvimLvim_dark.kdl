// Lvim Colorscheme LvimDark — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#d1aa64"
        inactive-color "#718650"
    }
    border {
        active-color "#d1aa64"
        inactive-color "#718650"
        urgent-color "#d75e52a6"
    }
}
