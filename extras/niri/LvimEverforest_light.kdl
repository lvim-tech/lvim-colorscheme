// Lvim Colorscheme EverforestLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#998853"
        inactive-color "#8a8e46"
    }
    border {
        active-color "#998853"
        inactive-color "#8a8e46"
        urgent-color "#c74d4da6"
    }
}
