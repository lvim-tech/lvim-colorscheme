// Lvim Colorscheme SolarizedDark — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#917b43"
        inactive-color "#666f37"
    }
    border {
        active-color "#917b43"
        inactive-color "#666f37"
        urgent-color "#c24f4da6"
    }
}
