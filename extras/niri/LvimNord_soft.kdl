// Lvim Colorscheme NordSoft — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#b99c64"
        inactive-color "#788c67"
    }
    border {
        active-color "#b99c64"
        inactive-color "#788c67"
        urgent-color "#ac6e74a6"
    }
}
