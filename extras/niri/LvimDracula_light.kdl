// Lvim Colorscheme DraculaLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#7c8158"
        inactive-color "#507a57"
    }
    border {
        active-color "#7c8158"
        inactive-color "#507a57"
        urgent-color "#af5959a6"
    }
}
