// Lvim Colorscheme NordLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#967e50"
        inactive-color "#5d6d50"
    }
    border {
        active-color "#967e50"
        inactive-color "#5d6d50"
        urgent-color "#976065a6"
    }
}
