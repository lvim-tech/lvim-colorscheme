// Lvim Colorscheme RosepineDarker — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#ac9682"
        inactive-color "#697d6d"
    }
    border {
        active-color "#ac9682"
        inactive-color "#697d6d"
        urgent-color "#a0727ca6"
    }
}
