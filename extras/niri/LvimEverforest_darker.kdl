// Lvim Colorscheme EverforestDarker — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#a6935a"
        inactive-color "#656831"
    }
    border {
        active-color "#a6935a"
        inactive-color "#656831"
        urgent-color "#cb4f4fa6"
    }
}
