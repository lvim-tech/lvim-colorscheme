// Lvim Colorscheme MaterialDark — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#c79e5e"
        inactive-color "#83a15c"
    }
    border {
        active-color "#c79e5e"
        inactive-color "#83a15c"
        urgent-color "#d05e64a6"
    }
}
