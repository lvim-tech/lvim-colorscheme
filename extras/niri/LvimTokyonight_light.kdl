// Lvim Colorscheme TokyonightLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#9d8465"
        inactive-color "#6c7e5b"
    }
    border {
        active-color "#9d8465"
        inactive-color "#6c7e5b"
        urgent-color "#ab5867a6"
    }
}
