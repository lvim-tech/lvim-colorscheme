// Lvim Colorscheme MaterialLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#997947"
        inactive-color "#748f51"
    }
    border {
        active-color "#997947"
        inactive-color "#748f51"
        urgent-color "#b14b51a6"
    }
}
