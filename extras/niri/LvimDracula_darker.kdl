// Lvim Colorscheme DraculaDarker — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#a3a975"
        inactive-color "#598861"
    }
    border {
        active-color "#a3a975"
        inactive-color "#598861"
        urgent-color "#bc6060a6"
    }
}
