// Lvim Colorscheme KanagawaLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#87734c"
        inactive-color "#728559"
    }
    border {
        active-color "#87734c"
        inactive-color "#728559"
        urgent-color "#c35959a6"
    }
}
