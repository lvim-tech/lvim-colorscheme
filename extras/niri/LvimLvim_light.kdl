// Lvim Colorscheme LvimLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#8e7242"
        inactive-color "#637646"
    }
    border {
        active-color "#8e7242"
        inactive-color "#637646"
        urgent-color "#ae4b41a6"
    }
}
