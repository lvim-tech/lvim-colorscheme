// Lvim Colorscheme RosepineLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#958270"
        inactive-color "#677b6b"
    }
    border {
        active-color "#958270"
        inactive-color "#677b6b"
        urgent-color "#8e656ea6"
    }
}
