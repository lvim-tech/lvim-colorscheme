// Lvim Colorscheme NightfoxLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#938151"
        inactive-color "#557063"
    }
    border {
        active-color "#938151"
        inactive-color "#557063"
        urgent-color "#a75d70a6"
    }
}
