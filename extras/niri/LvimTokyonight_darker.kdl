// Lvim Colorscheme TokyonightDarker — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#ad9170"
        inactive-color "#697b58"
    }
    border {
        active-color "#ad9170"
        inactive-color "#697b58"
        urgent-color "#bb6171a6"
    }
}
