// Lvim Colorscheme GruvboxLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#988857"
        inactive-color "#8a8e52"
    }
    border {
        active-color "#988857"
        inactive-color "#8a8e52"
        urgent-color "#c74e4ea6"
    }
}
