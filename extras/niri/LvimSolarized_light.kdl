// Lvim Colorscheme SolarizedLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#836f3c"
        inactive-color "#7f8a46"
    }
    border {
        active-color "#836f3c"
        inactive-color "#7f8a46"
        urgent-color "#ca5350a6"
    }
}
