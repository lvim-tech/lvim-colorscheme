// Lvim Colorscheme NightfoxDark — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#b19c63"
        inactive-color "#6a8b7b"
    }
    border {
        active-color "#b19c63"
        inactive-color "#6a8b7b"
        urgent-color "#b26377a6"
    }
}
