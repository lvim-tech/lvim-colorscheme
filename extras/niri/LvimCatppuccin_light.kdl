// Lvim Colorscheme CatppuccinLight — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#948161"
        inactive-color "#5e825c"
    }
    border {
        active-color "#948161"
        inactive-color "#5e825c"
        urgent-color "#a45a6da6"
    }
}
