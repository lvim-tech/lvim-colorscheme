// Lvim Colorscheme KanagawaDark — generated by lvim-colorscheme.
// Included from config.kdl, LAST, so these override the layout above.

layout {
    focus-ring {
        active-color "#cbae75"
        inactive-color "#64754e"
    }
    border {
        active-color "#cbae75"
        inactive-color "#64754e"
        urgent-color "#ba5454a6"
    }
}
