        }
        exit_code_success {
            base "#5f6141"
            background "#dadada"
            emphasis_0 "#44655d"
            emphasis_1 "#4c664f"
            emphasis_2 "#5f6141"
            emphasis_3 "#815343"
        }
        exit_code_error {
            base "#954545"
            background "#dadada"
            emphasis_0 "#835337"
            emphasis_1 "#675e47"
            emphasis_2 "#815343"
            emphasis_3 "#615d6a"
        }
        multiplayer_user_colors {
            player_1 "#915a47"
            player_2 "#5988a3"
            player_3 "#7a7d48"
            player_4 "#875537"
            player_5 "#918c9d"
