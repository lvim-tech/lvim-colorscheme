// Lvim Colorscheme GruvboxLight
themes {
    lvim {
        text_unselected {
            base "#4c6262"
            background "#dadada"
            emphasis_0 "#835337"
            emphasis_1 "#4c664f"
            emphasis_2 "#5f6141"
            emphasis_3 "#815343"
        }
        text_selected {
            base "#476567"
            background "#e9e9e9"
            emphasis_0 "#835337"
            emphasis_1 "#4c664f"
            emphasis_2 "#5f6141"
            emphasis_3 "#815343"
        }
        ribbon_selected {
            base "#ffffff"
            background "#777a48"
            emphasis_0 "#c74e4e"
            emphasis_1 "#875537"
            emphasis_2 "#915a47"
            emphasis_3 "#918c9d"
        }
        ribbon_unselected {
            base "#4c6262"
            background "#eeeeee"
            emphasis_0 "#835337"
            emphasis_1 "#476567"
            emphasis_2 "#815343"
            emphasis_3 "#615d6a"
        }
        table_title {
            base "#5f6141"
            background "#dadada"
            emphasis_0 "#835337"
            emphasis_1 "#4c664f"
            emphasis_2 "#5f6141"
