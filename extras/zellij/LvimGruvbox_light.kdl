            emphasis_0 "#835337"
            emphasis_1 "#4c664f"
            emphasis_2 "#5f6141"
            emphasis_3 "#815343"
        }
        list_selected {
            base "#476567"
            background "#e9e9e9"
            emphasis_0 "#835337"
            emphasis_1 "#4c664f"
            emphasis_2 "#5f6141"
            emphasis_3 "#815343"
        }
