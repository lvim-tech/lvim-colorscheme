            emphasis_1 "#3e7a89"
            emphasis_2 "#55673c"
            emphasis_3 "#4d86b6"
        }
        exit_code_success {
            base "#55673c"
            background "#dadada"
            emphasis_0 "#458677"
            emphasis_1 "#3e7a89"
            emphasis_2 "#55673c"
            emphasis_3 "#af5543"
        }
        exit_code_error {
            base "#ae4b41"
            background "#dadada"
            emphasis_0 "#aa703f"
            emphasis_1 "#856e42"
            emphasis_2 "#af5543"
            emphasis_3 "#4d86b6"
        }
        multiplayer_user_colors {
            player_1 "#af5543"
            player_2 "#457da3"
            player_3 "#55673c"
            player_4 "#aa703f"
            player_5 "#4d86b6"
            player_6 "#458677"
