            emphasis_0 "#aa703f"
            emphasis_1 "#3e7a89"
            emphasis_2 "#55673c"
            emphasis_3 "#af5543"
        }
        table_cell_unselected {
            base "#5e8888"
            background "#dadada"
            emphasis_0 "#aa703f"
            emphasis_1 "#3e7a89"
            emphasis_2 "#55673c"
            emphasis_3 "#af5543"
        }
        list_selected {
            base "#55a6ab"
            background "#e9e9e9"
            emphasis_0 "#aa703f"
            emphasis_1 "#3e7a89"
            emphasis_2 "#55673c"
            emphasis_3 "#af5543"
        }
        list_unselected {
            base "#5e8888"
            background "#dadada"
            emphasis_0 "#aa703f"
            emphasis_1 "#3e7a89"
            emphasis_2 "#55673c"
            emphasis_3 "#af5543"
        }
        frame_selected {
            base "#457da3"
            background "#dadada"
            emphasis_0 "#aa703f"
