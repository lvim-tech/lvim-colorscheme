// Lvim Colorscheme LvimLight
themes {
    lvim {
        text_unselected {
            base "#5e8888"
            background "#dadada"
            emphasis_0 "#aa703f"
            emphasis_1 "#3e7a89"
            emphasis_2 "#55673c"
            emphasis_3 "#af5543"
        }
        text_selected {
            base "#55a6ab"
            background "#e9e9e9"
            emphasis_0 "#aa703f"
            emphasis_1 "#3e7a89"
            emphasis_2 "#55673c"
            emphasis_3 "#af5543"
        }
        ribbon_selected {
            base "#dadada"
            background "#55673c"
            emphasis_0 "#ae4b41"
            emphasis_1 "#aa703f"
            emphasis_2 "#af5543"
            emphasis_3 "#4d86b6"
        }
        ribbon_unselected {
            base "#5e8888"
            background "#eeeeee"
            emphasis_0 "#aa703f"
            emphasis_1 "#55a6ab"
            emphasis_2 "#af5543"
            emphasis_3 "#4d86b6"
        }
        table_title {
            base "#55673c"
            background "#dadada"
            emphasis_0 "#aa703f"
            emphasis_1 "#3e7a89"
            emphasis_2 "#55673c"
            emphasis_3 "#af5543"
        }
        table_cell_selected {
