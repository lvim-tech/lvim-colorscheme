// Lvim Colorscheme DraculaLight
themes {
    lvim {
        text_unselected {
            base "#5e8888"
            background "#dadada"
            emphasis_0 "#9e703f"
            emphasis_1 "#2d7065"
            emphasis_2 "#2f7a42"
            emphasis_3 "#9f3d77"
        }
        text_selected {
            base "#55a6ab"
