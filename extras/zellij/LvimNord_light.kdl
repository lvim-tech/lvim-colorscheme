// Lvim Colorscheme NordLight
themes {
    lvim {
        text_unselected {
            base "#5e8888"
            background "#dadada"
            emphasis_0 "#7a564b"
            emphasis_1 "#6c919d"
            emphasis_2 "#7e8f70"
            emphasis_3 "#6e5a6b"
        }
        text_selected {
