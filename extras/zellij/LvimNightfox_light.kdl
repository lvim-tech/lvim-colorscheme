            background "#dadada"
            emphasis_0 "#599181"
            emphasis_1 "#5b8e8f"
            emphasis_2 "#749182"
            emphasis_3 "#755a88"
        }
        exit_code_error {
            base "#a75d70"
            background "#dadada"
            emphasis_0 "#ac7a53"
            emphasis_1 "#897a50"
            emphasis_2 "#755a88"
            emphasis_3 "#8069a2"
        }
        multiplayer_user_colors {
            player_1 "#755a88"
