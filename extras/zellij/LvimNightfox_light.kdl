// Lvim Colorscheme NightfoxLight
themes {
    lvim {
        text_unselected {
            base "#5e8888"
            background "#dadada"
            emphasis_0 "#ac7a53"
            emphasis_1 "#5b8e8f"
            emphasis_2 "#749182"
            emphasis_3 "#755a88"
        }
        text_selected {
            base "#55a6ab"
            background "#e9e9e9"
            emphasis_0 "#ac7a53"
            emphasis_1 "#5b8e8f"
            emphasis_2 "#749182"
            emphasis_3 "#755a88"
        }
        ribbon_selected {
            base "#dadada"
            background "#749182"
            emphasis_0 "#a75d70"
            emphasis_1 "#ac7a53"
            emphasis_2 "#755a88"
            emphasis_3 "#8069a2"
        }
        ribbon_unselected {
            base "#5e8888"
            background "#eeeeee"
            emphasis_0 "#ac7a53"
            emphasis_1 "#55a6ab"
            emphasis_2 "#755a88"
            emphasis_3 "#8069a2"
        }
        table_title {
            base "#749182"
            background "#dadada"
            emphasis_0 "#ac7a53"
            emphasis_1 "#5b8e8f"
