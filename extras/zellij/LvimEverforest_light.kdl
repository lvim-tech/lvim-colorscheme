// Lvim Colorscheme EverforestLight
themes {
    lvim {
        text_unselected {
            base "#4c6262"
            background "#dadada"
            emphasis_0 "#89502c"
            emphasis_1 "#4c664f"
            emphasis_2 "#5f613b"
            emphasis_3 "#815343"
        }
        text_selected {
            base "#476567"
            background "#e9e9e9"
            emphasis_0 "#89502c"
