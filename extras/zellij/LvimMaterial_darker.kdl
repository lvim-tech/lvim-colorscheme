// Lvim Colorscheme MaterialDarker
themes {
    lvim {
        text_unselected {
            base "#b2c7c7"
            background "#182125"
            emphasis_0 "#d37a60"
            emphasis_1 "#65a1bd"
            emphasis_2 "#90ad68"
            emphasis_3 "#dd6c7c"
        }
        text_selected {
            base "#b8bec2"
