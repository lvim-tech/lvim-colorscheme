{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme NordDarker",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme NordDarker",
      "appearance": "dark",
      "style": {
        "background": "#1b1f26",
        "editor.background": "#191d24",
        "editor.foreground": "#b3bac6",
        "editor.line_number": "#848b98",
        "editor.active_line_number": "#b4bac6",
        "editor.active_line.background": "#1d2128",
        "editor.gutter.background": "#191d24",
        "text": "#b3bac6",
        "text.muted": "#677185",
        "text.accent": "#73889e",
        "border": "#1f232a",
        "surface.background": "#191d24",
        "elevated_surface.background": "#191d24",
        "element.background": "#1d2128",
        "element.hover": "#1f232a",
        "element.selected": "#1f232a",
        "element.active": "#1f232a",
        "element.disabled": "#1d2128",
        "ghost_element.background": "#1d2128",
        "ghost_element.hover": "#1f232a",
        "ghost_element.selected": "#1f232a",
        "ghost_element.active": "#1f232a",
        "ghost_element.disabled": "#1d2128",
        "drop_target.background": "#1f232a",
        "status_bar.background": "#1d2128",
        "title_bar.background": "#1d2128",
        "toolbar.background": "#191d24",
        "tab_bar.background": "#1d2128",
        "tab.active_background": "#191d24",
        "tab.inactive_background": "#1d2128",
        "panel.background": "#1d2128",
        "scrollbar.thumb.background": "#1f232a",
        "terminal.background": "#1b1f26",
        "terminal.foreground": "#b3bac6",
        "terminal.ansi.black": "#171a20",
        "terminal.ansi.red": "#ac6e74",
        "terminal.ansi.green": "#879978",
        "terminal.ansi.yellow": "#c3a870",
        "terminal.ansi.blue": "#637b93",
        "terminal.ansi.magenta": "#a2869d",
        "terminal.ansi.cyan": "#7097a3",
        "terminal.ansi.white": "#6b7179",
        "terminal.ansi.bright_black": "#2a2f36",
        "terminal.ansi.bright_red": "#cc717b",
        "terminal.ansi.bright_green": "#8baa6e",
        "terminal.ansi.bright_yellow": "#dab459",
        "terminal.ansi.bright_blue": "#5d8ab0",
        "terminal.ansi.bright_magenta": "#c18ab8",
        "terminal.ansi.bright_cyan": "#64a8ba",
        "terminal.ansi.bright_white": "#7e8590",
        "created": "#879978",
        "modified": "#c3a870",
        "deleted": "#ac6e74",
        "error": "#ac6e74",
        "warning": "#c3a870",
        "info": "#73889e",
        "hint": "#7097a3",
        "syntax": {
          "comment": { "color": "#677185", "font_style": "italic" },
          "string": { "color": "#879978" },
          "string.regex": { "color": "#7097a3" },
          "number": { "color": "#b88473" },
          "constant": { "color": "#b88473" },
          "keyword": { "color": "#887f93" },
          "function": { "color": "#73889e" },
          "function.method": { "color": "#73889e" },
          "type": { "color": "#c3a870" },
          "variable": { "color": "#b3bac6" },
          "variable.special": { "color": "#ac6e74" },
          "property": { "color": "#7097a3" },
          "operator": { "color": "#7097a3" },
          "punctuation": { "color": "#848b98" },
          "tag": { "color": "#ac6e74" },
          "attribute": { "color": "#7097a3" },
          "title": { "color": "#73889e", "font_weight": 700 },
          "link_uri": { "color": "#7097a3" },
          "link_text": { "color": "#ac6e74" }
        }
      }
    }
  ]
