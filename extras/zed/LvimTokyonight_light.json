{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme TokyonightLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme TokyonightLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#878b9e",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#8085a2",
        "text.accent": "#6579ac",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "ghost_element.hover": "#e9e9e9",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#ab5867",
        "terminal.ansi.green": "#606f52",
        "terminal.ansi.yellow": "#927d61",
        "terminal.ansi.blue": "#7487bd",
        "terminal.ansi.magenta": "#765ba6",
        "terminal.ansi.cyan": "#587387",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#d4506d",
        "terminal.ansi.bright_green": "#657e4b",
        "terminal.ansi.bright_yellow": "#a88857",
        "terminal.ansi.bright_blue": "#7994d9",
        "terminal.ansi.bright_magenta": "#8860ca",
        "terminal.ansi.bright_cyan": "#5182a1",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#606f52",
        "modified": "#927d61",
        "deleted": "#ab5867",
        "error": "#ab5867",
        "warning": "#927d61",
        "info": "#6579ac",
        "hint": "#587387",
        "syntax": {
          "comment": { "color": "#8085a2", "font_style": "italic" },
          "string": { "color": "#606f52" },
          "string.regex": { "color": "#587387" },
          "number": { "color": "#b17f67" },
          "constant": { "color": "#b17f67" },
          "keyword": { "color": "#8b7ea3" },
          "function": { "color": "#6579ac" },
          "function.method": { "color": "#6579ac" },
          "type": { "color": "#927d61" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#ab5867" },
          "property": { "color": "#587387" },
          "operator": { "color": "#587387" },
          "punctuation": { "color": "#878b9e" },
          "tag": { "color": "#ab5867" },
          "attribute": { "color": "#587387" },
          "title": { "color": "#6579ac", "font_weight": 700 },
          "link_uri": { "color": "#587387" },
          "link_text": { "color": "#ab5867" }
        }
      }
    }
  ]
}