{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme SolarizedDarker",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme SolarizedDarker",
      "appearance": "dark",
      "style": {
        "background": "#001d25",
        "editor.background": "#001b23",
        "editor.foreground": "#9da4a4",
        "editor.line_number": "#5f6a6e",
        "editor.active_line_number": "#969e9e",
        "editor.active_line.background": "#001f27",
        "editor.gutter.background": "#001b23",
        "text": "#9da4a4",
        "text.muted": "#5d6a6f",
        "text.accent": "#4f7ea3",
        "border": "#022129",
        "surface.background": "#001b23",
        "elevated_surface.background": "#001b23",
        "element.background": "#001f27",
        "element.hover": "#022129",
        "element.selected": "#022129",
        "ghost_element.hover": "#022129",
        "drop_target.background": "#022129",
        "status_bar.background": "#001f27",
        "title_bar.background": "#001f27",
        "toolbar.background": "#001b23",
        "tab_bar.background": "#001f27",
        "tab.active_background": "#001b23",
        "tab.inactive_background": "#001f27",
        "panel.background": "#001f27",
        "scrollbar.thumb.background": "#022129",
        "terminal.background": "#001d25",
        "terminal.foreground": "#9da4a4",
        "terminal.ansi.black": "#00191f",
        "terminal.ansi.red": "#c24f4d",
        "terminal.ansi.green": "#727c3e",
        "terminal.ansi.yellow": "#9f8549",
        "terminal.ansi.blue": "#477193",
        "terminal.ansi.magenta": "#c0578a",
        "terminal.ansi.cyan": "#4b8580",
        "terminal.ansi.white": "#626666",
        "terminal.ansi.bright_black": "#102b32",
        "terminal.ansi.bright_red": "#ea4440",
        "terminal.ansi.bright_green": "#7d8b25",
        "terminal.ansi.bright_yellow": "#b4912e",
        "terminal.ansi.bright_blue": "#3680b0",
        "terminal.ansi.bright_magenta": "#e64d9d",
        "terminal.ansi.bright_cyan": "#37968f",
        "terminal.ansi.bright_white": "#6c7070",
        "created": "#727c3e",
        "modified": "#9f8549",
        "deleted": "#c24f4d",
        "error": "#c24f4d",
        "warning": "#9f8549",
        "info": "#4f7ea3",
        "hint": "#4b8580",
        "syntax": {
          "comment": { "color": "#5d6a6f", "font_style": "italic" },
          "string": { "color": "#727c3e" },
          "string.regex": { "color": "#4b8580" },
          "number": { "color": "#b46548" },
          "constant": { "color": "#b46548" },
          "keyword": { "color": "#757797" },
          "function": { "color": "#4f7ea3" },
          "function.method": { "color": "#4f7ea3" },
          "type": { "color": "#9f8549" },
          "variable": { "color": "#9da4a4" },
          "variable.special": { "color": "#c24f4d" },
          "property": { "color": "#4b8580" },
          "operator": { "color": "#4b8580" },
          "punctuation": { "color": "#5f6a6e" },
          "tag": { "color": "#c24f4d" },
          "attribute": { "color": "#4b8580" },
          "title": { "color": "#4f7ea3", "font_weight": 700 },
          "link_uri": { "color": "#4b8580" },
          "link_text": { "color": "#c24f4d" }
        }
      }
    }
  ]
}