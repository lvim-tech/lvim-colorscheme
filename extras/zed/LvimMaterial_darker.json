{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme MaterialDarker",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme MaterialDarker",
      "appearance": "dark",
      "style": {
        "background": "#1a2327",
        "editor.background": "#182125",
        "editor.foreground": "#b2c7c7",
        "editor.line_number": "#5e6a70",
        "editor.active_line_number": "#b8bec2",
        "editor.active_line.background": "#1c2529",
        "editor.gutter.background": "#182125",
        "text": "#b2c7c7",
        "text.muted": "#5e6a70",
        "text.accent": "#5b7fcb",
        "border": "#1e272b",
        "surface.background": "#182125",
        "elevated_surface.background": "#182125",
        "element.background": "#1c2529",
        "element.hover": "#1e272b",
        "element.selected": "#1e272b",
        "ghost_element.hover": "#1e272b",
        "drop_target.background": "#1e272b",
        "status_bar.background": "#1c2529",
        "title_bar.background": "#1c2529",
        "toolbar.background": "#182125",
        "tab_bar.background": "#1c2529",
        "tab.active_background": "#182125",
        "tab.inactive_background": "#1c2529",
        "panel.background": "#1c2529",
        "scrollbar.thumb.background": "#1e272b",
        "terminal.background": "#1a2327",
        "terminal.foreground": "#b2c7c7",
        "terminal.ansi.black": "#161e21",
        "terminal.ansi.red": "#d05e64",
        "terminal.ansi.green": "#90ad68",
        "terminal.ansi.yellow": "#cfa96a",
        "terminal.ansi.blue": "#4f6fbb",
        "terminal.ansi.magenta": "#d75d70",
        "terminal.ansi.cyan": "#65a1bd",
        "terminal.ansi.white": "#727b7b",
        "terminal.ansi.bright_black": "#293337",
        "terminal.ansi.bright_red": "#e6666d",
        "terminal.ansi.bright_green": "#95be51",
        "terminal.ansi.bright_yellow": "#e7b44e",
        "terminal.ansi.bright_blue": "#3e7ae8",
        "terminal.ansi.bright_magenta": "#ec667b",
        "terminal.ansi.bright_cyan": "#4eb2d9",
        "terminal.ansi.bright_white": "#849090",
        "created": "#90ad68",
        "modified": "#cfa96a",
        "deleted": "#d05e64",
        "error": "#d05e64",
        "warning": "#cfa96a",
        "info": "#5b7fcb",
        "hint": "#65a1bd",
        "syntax": {
          "comment": { "color": "#5e6a70", "font_style": "italic" },
          "string": { "color": "#90ad68" },
          "string.regex": { "color": "#65a1bd" },
          "number": { "color": "#d37a60" },
          "constant": { "color": "#d37a60" },
          "keyword": { "color": "#8f74a3" },
          "function": { "color": "#5b7fcb" },
          "function.method": { "color": "#5b7fcb" },
          "type": { "color": "#cfa96a" },
          "variable": { "color": "#b2c7c7" },
          "variable.special": { "color": "#d05e64" },
          "property": { "color": "#65a1bd" },
          "operator": { "color": "#65a1bd" },
          "punctuation": { "color": "#5e6a70" },
          "tag": { "color": "#d05e64" },
          "attribute": { "color": "#65a1bd" },
          "title": { "color": "#5b7fcb", "font_weight": 700 },
          "link_uri": { "color": "#65a1bd" },
          "link_text": { "color": "#d05e64" }
        }
      }
    }
  ]
}