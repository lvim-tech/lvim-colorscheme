          "comment": { "color": "#6c7393", "font_style": "italic" },
          "string": { "color": "#6b8d69" },
          "string.regex": { "color": "#65878e" },
          "number": { "color": "#b88970" },
          "constant": { "color": "#b88970" },
          "keyword": { "color": "#7c609b" },
          "function": { "color": "#6076a0" },
          "function.method": { "color": "#6076a0" },
          "type": { "color": "#b8a47e" },
          "variable": { "color": "#b2b7c7" },
          "variable.special": { "color": "#b7657a" },
          "property": { "color": "#65878e" },
          "operator": { "color": "#65878e" },
          "punctuation": { "color": "#868995" },
          "tag": { "color": "#b7657a" },
          "attribute": { "color": "#65878e" },
          "title": { "color": "#6076a0", "font_weight": 700 },
          "link_uri": { "color": "#65878e" },
          "link_text": { "color": "#b7657a" }
        }
