{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme CatppuccinDarker",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme CatppuccinDarker",
      "appearance": "dark",
      "style": {
        "background": "#16171e",
        "editor.background": "#14151c",
        "editor.foreground": "#b2b7c7",
        "editor.line_number": "#868995",
        "editor.active_line_number": "#b2b7c7",
        "editor.active_line.background": "#181920",
        "editor.gutter.background": "#14151c",
        "text": "#b2b7c7",
        "text.muted": "#6c7393",
        "text.accent": "#6076a0",
        "border": "#1a1b22",
        "surface.background": "#14151c",
        "elevated_surface.background": "#14151c",
        "element.background": "#181920",
        "element.hover": "#1a1b22",
        "element.selected": "#1a1b22",
        "ghost_element.hover": "#1a1b22",
        "drop_target.background": "#1a1b22",
        "status_bar.background": "#181920",
        "title_bar.background": "#181920",
        "toolbar.background": "#14151c",
        "tab_bar.background": "#181920",
        "tab.active_background": "#14151c",
        "tab.inactive_background": "#181920",
        "panel.background": "#181920",
        "scrollbar.thumb.background": "#1a1b22",
        "terminal.background": "#16171e",
        "terminal.foreground": "#b2b7c7",
        "terminal.ansi.black": "#13141a",
        "terminal.ansi.red": "#b7657a",
        "terminal.ansi.green": "#6b8d69",
        "terminal.ansi.yellow": "#b8a47e",
        "terminal.ansi.blue": "#546891",
        "terminal.ansi.magenta": "#b976a7",
        "terminal.ansi.cyan": "#65878e",
        "terminal.ansi.white": "#6a6e7d",
        "terminal.ansi.bright_black": "#26272f",
        "terminal.ansi.bright_red": "#d86685",
        "terminal.ansi.bright_green": "#649f5f",
        "terminal.ansi.bright_yellow": "#ceb06f",
        "terminal.ansi.bright_blue": "#4f74b5",
        "terminal.ansi.bright_magenta": "#d57abe",
        "terminal.ansi.bright_cyan": "#5b97a2",
        "terminal.ansi.bright_white": "#7c8296",
