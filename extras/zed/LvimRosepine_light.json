{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme RosepineLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme RosepineLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#7f7b7e",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#95718d",
        "text.accent": "#73878f",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "element.active": "#e9e9e9",
        "element.disabled": "#E4E4E4",
        "ghost_element.background": "#E4E4E4",
        "ghost_element.hover": "#e9e9e9",
        "ghost_element.selected": "#e9e9e9",
        "ghost_element.active": "#e9e9e9",
        "ghost_element.disabled": "#E4E4E4",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#8e656e",
        "terminal.ansi.green": "#5d6c60",
        "terminal.ansi.yellow": "#675a4d",
        "terminal.ansi.blue": "#7e949d",
        "terminal.ansi.magenta": "#6d5f81",
        "terminal.ansi.cyan": "#606d6d",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#b86278",
        "terminal.ansi.bright_green": "#5a7d62",
        "terminal.ansi.bright_yellow": "#7c6449",
        "terminal.ansi.bright_blue": "#78a4b5",
        "terminal.ansi.bright_magenta": "#8263a9",
        "terminal.ansi.bright_cyan": "#5e7d7d",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#5d6c60",
        "modified": "#675a4d",
        "deleted": "#8e656e",
        "error": "#8e656e",
        "warning": "#675a4d",
        "info": "#73878f",
        "hint": "#606d6d",
        "syntax": {
          "comment": { "color": "#95718d", "font_style": "italic" },
          "string": { "color": "#5d6c60" },
          "string.regex": { "color": "#606d6d" },
          "number": { "color": "#846564" },
          "constant": { "color": "#846564" },
          "keyword": { "color": "#7f7c88" },
          "function": { "color": "#73878f" },
          "function.method": { "color": "#73878f" },
          "type": { "color": "#675a4d" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#8e656e" },
          "property": { "color": "#606d6d" },
          "operator": { "color": "#606d6d" },
          "punctuation": { "color": "#7f7b7e" },
          "tag": { "color": "#8e656e" },
          "attribute": { "color": "#606d6d" },
          "title": { "color": "#73878f", "font_weight": 700 },
          "link_uri": { "color": "#606d6d" },
          "link_text": { "color": "#8e656e" }
        }
