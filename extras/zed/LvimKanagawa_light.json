{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme KanagawaLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme KanagawaLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#a3a3b1",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#9d9db5",
        "text.accent": "#6385c2",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "element.active": "#e9e9e9",
        "element.disabled": "#E4E4E4",
        "ghost_element.background": "#E4E4E4",
        "ghost_element.hover": "#e9e9e9",
        "ghost_element.selected": "#e9e9e9",
        "ghost_element.active": "#e9e9e9",
        "ghost_element.disabled": "#E4E4E4",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#c35959",
        "terminal.ansi.green": "#697b51",
        "terminal.ansi.yellow": "#584b31",
        "terminal.ansi.blue": "#6c8dcc",
        "terminal.ansi.magenta": "#94544f",
        "terminal.ansi.cyan": "#5e827b",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#e25a5a",
        "terminal.ansi.bright_green": "#6f8b45",
        "terminal.ansi.bright_yellow": "#695629",
        "terminal.ansi.bright_blue": "#709ae6",
        "terminal.ansi.bright_magenta": "#b85349",
        "terminal.ansi.bright_cyan": "#549388",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#697b51",
        "modified": "#584b31",
        "deleted": "#c35959",
        "error": "#c35959",
        "warning": "#584b31",
        "info": "#6385c2",
        "hint": "#5e827b",
        "syntax": {
          "comment": { "color": "#9d9db5", "font_style": "italic" },
          "string": { "color": "#697b51" },
          "string.regex": { "color": "#5e827b" },
          "number": { "color": "#816040" },
          "constant": { "color": "#816040" },
          "keyword": { "color": "#887fa0" },
          "function": { "color": "#6385c2" },
          "function.method": { "color": "#6385c2" },
          "type": { "color": "#584b31" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#c35959" },
          "property": { "color": "#5e827b" },
          "operator": { "color": "#5e827b" },
          "punctuation": { "color": "#a3a3b1" },
          "tag": { "color": "#c35959" },
          "attribute": { "color": "#5e827b" },
          "title": { "color": "#6385c2", "font_weight": 700 },
          "link_uri": { "color": "#5e827b" },
          "link_text": { "color": "#c35959" }
        }
      }
    }
  ]
}