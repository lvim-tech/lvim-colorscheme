{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme KanagawaSoft",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme KanagawaSoft",
      "appearance": "dark",
      "style": {
        "background": "#24252b",
        "editor.background": "#222329",
        "editor.foreground": "#54546d",
        "editor.line_number": "#4b4b61",
        "editor.active_line_number": "#5d5d79",
        "editor.active_line.background": "#26272d",
        "editor.gutter.background": "#222329",
        "text": "#54546d",
        "text.muted": "#4e4e73",
        "text.accent": "#4e6a9c",
        "border": "#28292f",
        "surface.background": "#222329",
        "elevated_surface.background": "#222329",
        "element.background": "#26272d",
        "element.hover": "#28292f",
        "element.selected": "#28292f",
        "ghost_element.hover": "#28292f",
        "drop_target.background": "#28292f",
        "status_bar.background": "#26272d",
        "title_bar.background": "#26272d",
        "toolbar.background": "#222329",
        "tab_bar.background": "#26272d",
        "tab.active_background": "#222329",
        "tab.inactive_background": "#26272d",
        "panel.background": "#26272d",
        "scrollbar.thumb.background": "#28292f",
        "terminal.background": "#24252b",
        "terminal.foreground": "#a0a0bc",
        "terminal.ansi.black": "#1e1f24",
        "terminal.ansi.red": "#ba5454",
        "terminal.ansi.green": "#6c7f54",
        "terminal.ansi.yellow": "#d1b57c",
        "terminal.ansi.blue": "#496291",
        "terminal.ansi.magenta": "#c4726c",
        "terminal.ansi.cyan": "#587a74",
        "terminal.ansi.white": "#62627e",
        "terminal.ansi.bright_black": "#30313a",
        "terminal.ansi.bright_red": "#e14c4c",
        "terminal.ansi.bright_green": "#728f48",
        "terminal.ansi.bright_yellow": "#e8c165",
        "terminal.ansi.bright_blue": "#406eb5",
        "terminal.ansi.bright_magenta": "#dd7a72",
        "terminal.ansi.bright_cyan": "#4f8a81",
        "terminal.ansi.bright_white": "#6c6c89",
        "created": "#6c7f54",
        "modified": "#d1b57c",
        "deleted": "#ba5454",
        "error": "#ba5454",
        "warning": "#d1b57c",
        "info": "#4e6a9c",
        "hint": "#587a74",
        "syntax": {
          "comment": { "color": "#4e4e73", "font_style": "italic" },
          "string": { "color": "#6c7f54" },
          "string.regex": { "color": "#587a74" },
          "number": { "color": "#bf8f62" },
          "constant": { "color": "#bf8f62" },
          "keyword": { "color": "#70658b" },
          "function": { "color": "#4e6a9c" },
          "function.method": { "color": "#4e6a9c" },
          "type": { "color": "#d1b57c" },
          "variable": { "color": "#54546d" },
          "variable.special": { "color": "#ba5454" },
          "property": { "color": "#587a74" },
          "operator": { "color": "#587a74" },
          "punctuation": { "color": "#4b4b61" },
          "tag": { "color": "#ba5454" },
          "attribute": { "color": "#587a74" },
          "title": { "color": "#4e6a9c", "font_weight": 700 },
          "link_uri": { "color": "#587a74" },
          "link_text": { "color": "#ba5454" }
        }
      }
    }
  ]
}