          "comment": { "color": "#896882", "font_style": "italic" },
          "string": { "color": "#788b7c" },
          "string.regex": { "color": "#788787" },
          "number": { "color": "#a98a89" },
          "constant": { "color": "#a98a89" },
          "keyword": { "color": "#726f7c" },
          "function": { "color": "#5d6d74" },
          "function.method": { "color": "#5d6d74" },
          "type": { "color": "#b6a18b" },
          "variable": { "color": "#b3afb2" },
          "variable.special": { "color": "#a0727c" },
          "property": { "color": "#788787" },
          "operator": { "color": "#788787" },
          "punctuation": { "color": "#757174" },
          "tag": { "color": "#a0727c" },
          "attribute": { "color": "#788787" },
          "title": { "color": "#5d6d74", "font_weight": 700 },
          "link_uri": { "color": "#788787" },
          "link_text": { "color": "#a0727c" }
        }
