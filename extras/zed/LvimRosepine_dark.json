{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme RosepineDark",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme RosepineDark",
      "appearance": "dark",
      "style": {
        "background": "#1b191d",
        "editor.background": "#19171b",
        "editor.foreground": "#b3afb2",
        "editor.line_number": "#757174",
        "editor.active_line_number": "#b9b4b5",
        "editor.active_line.background": "#1d1b1f",
        "editor.gutter.background": "#19171b",
        "text": "#b3afb2",
        "text.muted": "#896882",
        "text.accent": "#5d6d74",
        "border": "#1f1d21",
        "surface.background": "#19171b",
        "elevated_surface.background": "#19171b",
        "element.background": "#1d1b1f",
        "element.hover": "#1f1d21",
        "element.selected": "#1f1d21",
        "ghost_element.hover": "#1f1d21",
        "drop_target.background": "#1f1d21",
        "status_bar.background": "#1d1b1f",
        "title_bar.background": "#1d1b1f",
        "toolbar.background": "#19171b",
        "tab_bar.background": "#1d1b1f",
        "tab.active_background": "#19171b",
        "tab.inactive_background": "#1d1b1f",
        "panel.background": "#1d1b1f",
        "scrollbar.thumb.background": "#1f1d21",
        "terminal.background": "#1b191d",
        "terminal.foreground": "#b3afb2",
        "terminal.ansi.black": "#171619",
        "terminal.ansi.red": "#a0727c",
        "terminal.ansi.green": "#788b7c",
        "terminal.ansi.yellow": "#b6a18b",
        "terminal.ansi.blue": "#526167",
        "terminal.ansi.magenta": "#9084a2",
        "terminal.ansi.cyan": "#788787",
        "terminal.ansi.white": "#696769",
        "terminal.ansi.bright_black": "#2a282c",
        "terminal.ansi.bright_red": "#c47387",
        "terminal.ansi.bright_green": "#729d7c",
        "terminal.ansi.bright_yellow": "#d0ac80",
        "terminal.ansi.bright_blue": "#50707b",
        "terminal.ansi.bright_magenta": "#a38dc1",
        "terminal.ansi.bright_cyan": "#749898",
        "terminal.ansi.bright_white": "#7e7b7d",
        "created": "#788b7c",
        "modified": "#b6a18b",
        "deleted": "#a0727c",
        "error": "#a0727c",
        "warning": "#b6a18b",
        "info": "#5d6d74",
        "hint": "#788787",
