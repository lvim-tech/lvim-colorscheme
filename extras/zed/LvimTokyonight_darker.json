{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme TokyonightDarker",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme TokyonightDarker",
      "appearance": "dark",
      "style": {
        "background": "#161920",
        "editor.background": "#14171e",
        "editor.foreground": "#b2b6c7",
        "editor.line_number": "#5e6274",
        "editor.active_line_number": "#b5b9ca",
        "editor.active_line.background": "#181b22",
        "editor.gutter.background": "#14171e",
        "text": "#b2b6c7",
        "text.muted": "#616784",
        "text.accent": "#6073a4",
        "border": "#1a1d24",
        "surface.background": "#14171e",
        "elevated_surface.background": "#14171e",
        "element.background": "#181b22",
        "element.hover": "#1a1d24",
        "element.selected": "#1a1d24",
        "ghost_element.hover": "#1a1d24",
        "drop_target.background": "#1a1d24",
        "status_bar.background": "#181b22",
        "title_bar.background": "#181b22",
        "toolbar.background": "#14171e",
        "tab_bar.background": "#181b22",
        "tab.active_background": "#14171e",
        "tab.inactive_background": "#181b22",
        "panel.background": "#181b22",
        "scrollbar.thumb.background": "#1a1d24",
        "terminal.background": "#161920",
        "terminal.foreground": "#b2b6c7",
        "terminal.ansi.black": "#13161b",
        "terminal.ansi.red": "#bb6171",
        "terminal.ansi.green": "#788a67",
        "terminal.ansi.yellow": "#b79d7b",
        "terminal.ansi.blue": "#546593",
        "terminal.ansi.magenta": "#907bba",
        "terminal.ansi.cyan": "#648299",
        "terminal.ansi.white": "#696d7e",
        "terminal.ansi.bright_black": "#262931",
        "terminal.ansi.bright_red": "#db6279",
        "terminal.ansi.bright_green": "#7d9a5d",
        "terminal.ansi.bright_yellow": "#d0a86d",
        "terminal.ansi.bright_blue": "#5071ba",
        "terminal.ansi.bright_magenta": "#a184d7",
        "terminal.ansi.bright_cyan": "#5b91b5",
        "terminal.ansi.bright_white": "#7c8196",
        "created": "#788a67",
        "modified": "#b79d7b",
        "deleted": "#bb6171",
        "error": "#bb6171",
        "warning": "#b79d7b",
        "info": "#6073a4",
        "hint": "#648299",
        "syntax": {
          "comment": { "color": "#616784", "font_style": "italic" },
          "string": { "color": "#788a67" },
          "string.regex": { "color": "#648299" },
          "number": { "color": "#bb866d" },
          "constant": { "color": "#bb866d" },
          "keyword": { "color": "#73638e" },
          "function": { "color": "#6073a4" },
          "function.method": { "color": "#6073a4" },
          "type": { "color": "#b79d7b" },
          "variable": { "color": "#b2b6c7" },
          "variable.special": { "color": "#bb6171" },
          "property": { "color": "#648299" },
          "operator": { "color": "#648299" },
          "punctuation": { "color": "#5e6274" },
          "tag": { "color": "#bb6171" },
          "attribute": { "color": "#648299" },
          "title": { "color": "#6073a4", "font_weight": 700 },
          "link_uri": { "color": "#648299" },
          "link_text": { "color": "#bb6171" }
        }
      }
    }
  ]
}