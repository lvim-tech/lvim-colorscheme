{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme BaseLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme BaseLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#93b6b6",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#789698",
        "text.accent": "#457da3",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "element.active": "#e9e9e9",
        "element.disabled": "#E4E4E4",
        "ghost_element.background": "#E4E4E4",
        "ghost_element.hover": "#e9e9e9",
        "ghost_element.selected": "#e9e9e9",
        "ghost_element.active": "#e9e9e9",
        "ghost_element.disabled": "#E4E4E4",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#ae4b41",
        "terminal.ansi.green": "#55673c",
        "terminal.ansi.yellow": "#5b4a2b",
        "terminal.ansi.blue": "#4e8db5",
        "terminal.ansi.magenta": "#af5543",
        "terminal.ansi.cyan": "#3e7a89",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#d24632",
        "terminal.ansi.bright_green": "#5b7630",
        "terminal.ansi.bright_yellow": "#6d5520",
        "terminal.ansi.bright_blue": "#2e9dd3",
        "terminal.ansi.bright_magenta": "#d15433",
        "terminal.ansi.bright_cyan": "#228a9f",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#55673c",
        "modified": "#5b4a2b",
        "deleted": "#ae4b41",
        "error": "#ae4b41",
        "warning": "#5b4a2b",
        "info": "#457da3",
        "hint": "#3e7a89",
        "syntax": {
          "comment": { "color": "#789698", "font_style": "italic" },
          "string": { "color": "#55673c" },
          "string.regex": { "color": "#3e7a89" },
          "number": { "color": "#7d512c" },
          "constant": { "color": "#7d512c" },
          "keyword": { "color": "#4d86b6" },
          "function": { "color": "#457da3" },
          "function.method": { "color": "#457da3" },
          "type": { "color": "#5b4a2b" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#ae4b41" },
          "property": { "color": "#3e7a89" },
          "operator": { "color": "#3e7a89" },
          "punctuation": { "color": "#93b6b6" },
          "tag": { "color": "#ae4b41" },
          "attribute": { "color": "#3e7a89" },
          "title": { "color": "#457da3", "font_weight": 700 },
          "link_uri": { "color": "#3e7a89" },
          "link_text": { "color": "#ae4b41" }
        }
      }
    }
  ]
}