{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme NordLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme NordLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#5f646e",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#737d95",
        "text.accent": "#596a7c",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "element.active": "#e9e9e9",
        "element.disabled": "#E4E4E4",
        "ghost_element.background": "#E4E4E4",
        "ghost_element.hover": "#e9e9e9",
        "ghost_element.selected": "#e9e9e9",
        "ghost_element.active": "#e9e9e9",
        "ghost_element.disabled": "#E4E4E4",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#976065",
        "terminal.ansi.green": "#616f56",
        "terminal.ansi.yellow": "#645537",
        "terminal.ansi.blue": "#60788f",
        "terminal.ansi.magenta": "#6e5a6b",
        "terminal.ansi.cyan": "#53727b",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#c15c67",
        "terminal.ansi.bright_green": "#667f50",
        "terminal.ansi.bright_yellow": "#76602d",
        "terminal.ansi.bright_blue": "#5a87ac",
        "terminal.ansi.bright_magenta": "#8e5c87",
        "terminal.ansi.bright_cyan": "#4b818f",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#616f56",
        "modified": "#645537",
        "deleted": "#976065",
        "error": "#976065",
        "warning": "#645537",
        "info": "#596a7c",
        "hint": "#53727b",
        "syntax": {
          "comment": { "color": "#737d95", "font_style": "italic" },
          "string": { "color": "#616f56" },
          "string.regex": { "color": "#53727b" },
          "number": { "color": "#7a564b" },
          "constant": { "color": "#7a564b" },
          "keyword": { "color": "#71687d" },
          "function": { "color": "#596a7c" },
          "function.method": { "color": "#596a7c" },
          "type": { "color": "#645537" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#976065" },
          "property": { "color": "#53727b" },
          "operator": { "color": "#53727b" },
          "punctuation": { "color": "#5f646e" },
          "tag": { "color": "#976065" },
          "attribute": { "color": "#53727b" },
          "title": { "color": "#596a7c", "font_weight": 700 },
          "link_uri": { "color": "#53727b" },
          "link_text": { "color": "#976065" }
        }
      }
    }
  ]
}