{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme DraculaSoft",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme DraculaSoft",
      "appearance": "dark",
      "style": {
        "background": "#272934",
        "editor.background": "#252732",
        "editor.foreground": "#c7c7b3",
        "editor.line_number": "#828287",
