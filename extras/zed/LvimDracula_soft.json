          "comment": { "color": "#727a98", "font_style": "italic" },
          "string": { "color": "#62966d" },
          "string.regex": { "color": "#66938a" },
          "number": { "color": "#b58f70" },
          "constant": { "color": "#b58f70" },
          "keyword": { "color": "#796496" },
          "function": { "color": "#638993" },
          "function.method": { "color": "#638993" },
          "type": { "color": "#adb27e" },
          "variable": { "color": "#c7c7b3" },
          "variable.special": { "color": "#bc6060" },
          "property": { "color": "#66938a" },
          "operator": { "color": "#66938a" },
          "punctuation": { "color": "#828287" },
          "tag": { "color": "#bc6060" },
          "attribute": { "color": "#66938a" },
          "title": { "color": "#638993", "font_weight": 700 },
          "link_uri": { "color": "#66938a" },
          "link_text": { "color": "#bc6060" }
