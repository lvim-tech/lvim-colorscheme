        "editor.active_line.background": "#292b36",
        "editor.gutter.background": "#252732",
        "text": "#c7c7b3",
        "text.muted": "#727a98",
        "text.accent": "#638993",
        "border": "#2b2d38",
        "surface.background": "#252732",
        "elevated_surface.background": "#252732",
        "element.background": "#292b36",
        "element.hover": "#2b2d38",
        "element.selected": "#2b2d38",
        "element.active": "#2b2d38",
        "element.disabled": "#292b36",
        "ghost_element.background": "#292b36",
        "ghost_element.hover": "#2b2d38",
        "ghost_element.selected": "#2b2d38",
        "ghost_element.active": "#2b2d38",
        "ghost_element.disabled": "#292b36",
        "drop_target.background": "#2b2d38",
        "status_bar.background": "#292b36",
        "title_bar.background": "#292b36",
        "toolbar.background": "#252732",
        "tab_bar.background": "#292b36",
        "tab.active_background": "#252732",
        "tab.inactive_background": "#292b36",
        "panel.background": "#292b36",
        "scrollbar.thumb.background": "#2b2d38",
        "terminal.background": "#272934",
        "terminal.foreground": "#c7c7b3",
        "terminal.ansi.black": "#21222b",
        "terminal.ansi.red": "#bc6060",
        "terminal.ansi.green": "#62966d",
        "terminal.ansi.yellow": "#adb27e",
        "terminal.ansi.blue": "#597c86",
        "terminal.ansi.magenta": "#bf6f9a",
        "terminal.ansi.cyan": "#66938a",
        "terminal.ansi.white": "#7c7c74",
        "terminal.ansi.bright_black": "#373941",
        "terminal.ansi.bright_red": "#da6262",
        "terminal.ansi.bright_green": "#54a869",
        "terminal.ansi.bright_yellow": "#bac26c",
        "terminal.ansi.bright_blue": "#4f8c9b",
        "terminal.ansi.bright_magenta": "#da73ac",
        "terminal.ansi.bright_cyan": "#59a597",
        "terminal.ansi.bright_white": "#919186",
