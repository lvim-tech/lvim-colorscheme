{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme SolarizedLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme SolarizedLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#7b888e",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#798890",
        "text.accent": "#4c799d",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "ghost_element.hover": "#e9e9e9",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#ca5350",
        "terminal.ansi.green": "#727c3e",
        "terminal.ansi.yellow": "#786435",
        "terminal.ansi.blue": "#5586ae",
        "terminal.ansi.magenta": "#b35181",
        "terminal.ansi.cyan": "#467c77",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#eb514c",
        "terminal.ansi.bright_green": "#7d8b25",
        "terminal.ansi.bright_yellow": "#8b7020",
        "terminal.ansi.bright_blue": "#4195cd",
        "terminal.ansi.bright_magenta": "#da4595",
        "terminal.ansi.bright_cyan": "#348d85",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#727c3e",
        "modified": "#786435",
        "deleted": "#ca5350",
        "error": "#ca5350",
        "warning": "#786435",
        "info": "#4c799d",
        "hint": "#467c77",
        "syntax": {
          "comment": { "color": "#798890", "font_style": "italic" },
          "string": { "color": "#727c3e" },
          "string.regex": { "color": "#467c77" },
          "number": { "color": "#ab6044" },
          "constant": { "color": "#ab6044" },
          "keyword": { "color": "#707293" },
          "function": { "color": "#4c799d" },
          "function.method": { "color": "#4c799d" },
          "type": { "color": "#786435" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#ca5350" },
          "property": { "color": "#467c77" },
          "operator": { "color": "#467c77" },
          "punctuation": { "color": "#7b888e" },
          "tag": { "color": "#ca5350" },
          "attribute": { "color": "#467c77" },
          "title": { "color": "#4c799d", "font_weight": 700 },
          "link_uri": { "color": "#467c77" },
          "link_text": { "color": "#ca5350" }
        }
      }
    }
  ]
}