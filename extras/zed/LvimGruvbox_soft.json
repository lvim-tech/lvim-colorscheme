{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme GruvboxSoft",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme GruvboxSoft",
      "appearance": "dark",
      "style": {
        "background": "#262524",
        "editor.background": "#242322",
        "editor.foreground": "#645c54",
        "editor.line_number": "#544c45",
        "editor.active_line_number": "#746c63",
        "editor.active_line.background": "#282726",
        "editor.gutter.background": "#242322",
        "text": "#645c54",
        "text.muted": "#64584e",
        "text.accent": "#497188",
        "border": "#2a2928",
        "surface.background": "#242322",
        "elevated_surface.background": "#242322",
        "element.background": "#282726",
        "element.hover": "#2a2928",
        "element.selected": "#2a2928",
        "ghost_element.hover": "#2a2928",
        "drop_target.background": "#2a2928",
        "status_bar.background": "#282726",
        "title_bar.background": "#282726",
        "toolbar.background": "#242322",
        "tab_bar.background": "#282726",
        "tab.active_background": "#242322",
        "tab.inactive_background": "#282726",
        "panel.background": "#282726",
        "scrollbar.thumb.background": "#2a2928",
        "terminal.background": "#262524",
        "terminal.foreground": "#b49f88",
        "terminal.ansi.black": "#201f1e",
        "terminal.ansi.red": "#ca4f4f",
        "terminal.ansi.green": "#757845",
        "terminal.ansi.yellow": "#af9e6b",
        "terminal.ansi.blue": "#3f6376",
        "terminal.ansi.magenta": "#bb755e",
        "terminal.ansi.cyan": "#527a57",
        "terminal.ansi.white": "#786d61",
        "terminal.ansi.bright_black": "#34312e",
        "terminal.ansi.bright_red": "#ea4c4c",
        "terminal.ansi.bright_green": "#828633",
        "terminal.ansi.bright_yellow": "#c3ab58",
        "terminal.ansi.bright_blue": "#33728d",
        "terminal.ansi.bright_magenta": "#dd7950",
        "terminal.ansi.bright_cyan": "#488b52",
        "terminal.ansi.bright_white": "#786d62",
        "created": "#757845",
        "modified": "#af9e6b",
        "deleted": "#ca4f4f",
        "error": "#ca4f4f",
        "warning": "#af9e6b",
        "info": "#497188",
        "hint": "#527a57",
        "syntax": {
          "comment": { "color": "#64584e", "font_style": "italic" },
          "string": { "color": "#757845" },
          "string.regex": { "color": "#527a57" },
          "number": { "color": "#c47d54" },
          "constant": { "color": "#c47d54" },
          "keyword": { "color": "#635d71" },
          "function": { "color": "#497188" },
          "function.method": { "color": "#497188" },
          "type": { "color": "#af9e6b" },
          "variable": { "color": "#645c54" },
          "variable.special": { "color": "#ca4f4f" },
          "property": { "color": "#527a57" },
          "operator": { "color": "#527a57" },
          "punctuation": { "color": "#544c45" },
          "tag": { "color": "#ca4f4f" },
          "attribute": { "color": "#527a57" },
          "title": { "color": "#497188", "font_weight": 700 },
          "link_uri": { "color": "#527a57" },
          "link_text": { "color": "#ca4f4f" }
        }
      }
    }
  ]
}