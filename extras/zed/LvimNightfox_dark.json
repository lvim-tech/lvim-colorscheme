{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme NightfoxDark",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme NightfoxDark",
      "appearance": "dark",
      "style": {
        "background": "#17212e",
        "editor.background": "#151f2c",
        "editor.foreground": "#bcbdbd",
        "editor.line_number": "#7b8189",
        "editor.active_line_number": "#bcbcbd",
        "editor.active_line.background": "#192330",
        "editor.gutter.background": "#151f2c",
        "text": "#bcbdbd",
        "text.muted": "#758292",
        "text.accent": "#6885ad",
        "border": "#1b2532",
        "surface.background": "#151f2c",
        "elevated_surface.background": "#151f2c",
        "element.background": "#192330",
        "element.hover": "#1b2532",
        "element.selected": "#1b2532",
        "ghost_element.hover": "#1b2532",
        "drop_target.background": "#1b2532",
        "status_bar.background": "#192330",
        "title_bar.background": "#192330",
        "toolbar.background": "#151f2c",
        "tab_bar.background": "#192330",
        "tab.active_background": "#151f2c",
        "tab.inactive_background": "#192330",
        "panel.background": "#192330",
        "scrollbar.thumb.background": "#1b2532",
        "terminal.background": "#17212e",
        "terminal.foreground": "#bcbdbd",
        "terminal.ansi.black": "#141c26",
        "terminal.ansi.red": "#b26377",
        "terminal.ansi.green": "#7b998a",
        "terminal.ansi.yellow": "#bba76f",
        "terminal.ansi.blue": "#5677a3",
        "terminal.ansi.magenta": "#9a80ae",
        "terminal.ansi.cyan": "#69a3a4",
        "terminal.ansi.white": "#737474",
        "terminal.ansi.bright_black": "#28313c",
        "terminal.ansi.bright_red": "#d66182",
        "terminal.ansi.bright_green": "#72ab90",
        "terminal.ansi.bright_yellow": "#d0b459",
        "terminal.ansi.bright_blue": "#4a85c6",
        "terminal.ansi.bright_magenta": "#af87cc",
        "terminal.ansi.bright_cyan": "#56b5b6",
        "terminal.ansi.bright_white": "#878888",
        "created": "#7b998a",
        "modified": "#bba76f",
        "deleted": "#b26377",
        "error": "#b26377",
        "warning": "#bba76f",
        "info": "#6885ad",
        "hint": "#69a3a4",
        "syntax": {
          "comment": { "color": "#758292", "font_style": "italic" },
          "string": { "color": "#7b998a" },
          "string.regex": { "color": "#69a3a4" },
          "number": { "color": "#c88e62" },
          "constant": { "color": "#c88e62" },
          "keyword": { "color": "#8670a7" },
          "function": { "color": "#6885ad" },
          "function.method": { "color": "#6885ad" },
          "type": { "color": "#bba76f" },
          "variable": { "color": "#bcbdbd" },
          "variable.special": { "color": "#b26377" },
          "property": { "color": "#69a3a4" },
          "operator": { "color": "#69a3a4" },
          "punctuation": { "color": "#7b8189" },
          "tag": { "color": "#b26377" },
          "attribute": { "color": "#69a3a4" },
          "title": { "color": "#6885ad", "font_weight": 700 },
          "link_uri": { "color": "#69a3a4" },
          "link_text": { "color": "#b26377" }
        }
      }
    }
  ]
}