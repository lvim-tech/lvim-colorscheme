{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme DraculaLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme DraculaLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#6b6b71",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#6b728f",
        "text.accent": "#517079",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "ghost_element.hover": "#e9e9e9",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#af5959",
        "terminal.ansi.green": "#466d4e",
        "terminal.ansi.yellow": "#777b56",
        "terminal.ansi.blue": "#5a7d87",
        "terminal.ansi.magenta": "#905274",
        "terminal.ansi.cyan": "#496b64",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#d95151",
        "terminal.ansi.bright_green": "#3d7e4c",
        "terminal.ansi.bright_yellow": "#83894b",
        "terminal.ansi.bright_blue": "#508d9c",
        "terminal.ansi.bright_magenta": "#b44d8a",
        "terminal.ansi.bright_cyan": "#417b70",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#466d4e",
        "modified": "#777b56",
        "deleted": "#af5959",
        "error": "#af5959",
        "warning": "#777b56",
        "info": "#517079",
        "hint": "#496b64",
        "syntax": {
          "comment": { "color": "#6b728f", "font_style": "italic" },
          "string": { "color": "#466d4e" },
          "string.regex": { "color": "#496b64" },
          "number": { "color": "#a38165" },
          "constant": { "color": "#a38165" },
          "keyword": { "color": "#8b79a6" },
          "function": { "color": "#517079" },
          "function.method": { "color": "#517079" },
          "type": { "color": "#777b56" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#af5959" },
          "property": { "color": "#496b64" },
          "operator": { "color": "#496b64" },
          "punctuation": { "color": "#6b6b71" },
          "tag": { "color": "#af5959" },
          "attribute": { "color": "#496b64" },
          "title": { "color": "#517079", "font_weight": 700 },
          "link_uri": { "color": "#496b64" },
          "link_text": { "color": "#af5959" }
        }
      }
    }
  ]
}