{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme MaterialLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme MaterialLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#7a8990",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#798991",
        "text.accent": "#4d6cae",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "ghost_element.hover": "#e9e9e9",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#b14b51",
        "terminal.ansi.green": "#6f864f",
        "terminal.ansi.yellow": "#8e7347",
        "terminal.ansi.blue": "#577acd",
        "terminal.ansi.magenta": "#b04556",
        "terminal.ansi.cyan": "#578ca5",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#d9404c",
        "terminal.ansi.bright_green": "#75963e",
        "terminal.ansi.bright_yellow": "#a37e35",
        "terminal.ansi.bright_blue": "#5786ec",
        "terminal.ansi.bright_magenta": "#d73858",
        "terminal.ansi.bright_cyan": "#439cbf",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#6f864f",
        "modified": "#8e7347",
        "deleted": "#b14b51",
        "error": "#b14b51",
        "warning": "#8e7347",
        "info": "#4d6cae",
        "hint": "#578ca5",
        "syntax": {
          "comment": { "color": "#798991", "font_style": "italic" },
          "string": { "color": "#6f864f" },
          "string.regex": { "color": "#578ca5" },
          "number": { "color": "#c9745b" },
          "constant": { "color": "#c9745b" },
          "keyword": { "color": "#806594" },
          "function": { "color": "#4d6cae" },
          "function.method": { "color": "#4d6cae" },
          "type": { "color": "#8e7347" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#b14b51" },
          "property": { "color": "#578ca5" },
          "operator": { "color": "#578ca5" },
          "punctuation": { "color": "#7a8990" },
          "tag": { "color": "#b14b51" },
          "attribute": { "color": "#578ca5" },
          "title": { "color": "#4d6cae", "font_weight": 700 },
          "link_uri": { "color": "#578ca5" },
          "link_text": { "color": "#b14b51" }
        }
      }
    }
  ]
}