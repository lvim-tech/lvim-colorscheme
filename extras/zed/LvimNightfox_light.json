{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme NightfoxLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme NightfoxLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#696e75",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#646f7d",
        "text.accent": "#546d8e",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "ghost_element.hover": "#e9e9e9",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#a75d70",
        "terminal.ansi.green": "#749182",
        "terminal.ansi.yellow": "#897a50",
        "terminal.ansi.blue": "#597ba8",
        "terminal.ansi.magenta": "#755a88",
        "terminal.ansi.cyan": "#5b8e8f",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#d0567a",
        "terminal.ansi.bright_green": "#6ca388",
        "terminal.ansi.bright_yellow": "#9c8641",
        "terminal.ansi.bright_blue": "#4d89cb",
        "terminal.ansi.bright_magenta": "#905ab1",
        "terminal.ansi.bright_cyan": "#4b9fa0",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#749182",
        "modified": "#897a50",
        "deleted": "#a75d70",
        "error": "#a75d70",
        "warning": "#897a50",
        "info": "#546d8e",
        "hint": "#5b8e8f",
        "syntax": {
          "comment": { "color": "#646f7d", "font_style": "italic" },
          "string": { "color": "#749182" },
          "string.regex": { "color": "#5b8e8f" },
          "number": { "color": "#ac7a53" },
          "constant": { "color": "#ac7a53" },
          "keyword": { "color": "#8069a2" },
          "function": { "color": "#546d8e" },
          "function.method": { "color": "#546d8e" },
          "type": { "color": "#897a50" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#a75d70" },
          "property": { "color": "#5b8e8f" },
          "operator": { "color": "#5b8e8f" },
          "punctuation": { "color": "#696e75" },
          "tag": { "color": "#a75d70" },
          "attribute": { "color": "#5b8e8f" },
          "title": { "color": "#546d8e", "font_weight": 700 },
          "link_uri": { "color": "#5b8e8f" },
          "link_text": { "color": "#a75d70" }
        }
      }
    }
  ]
}