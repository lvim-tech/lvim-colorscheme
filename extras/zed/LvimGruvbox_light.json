{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme GruvboxLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme GruvboxLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#b0a193",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#a59283",
        "text.accent": "#5988a3",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "ghost_element.hover": "#e9e9e9",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#c74e4e",
        "terminal.ansi.green": "#7a7d48",
        "terminal.ansi.yellow": "#8f8156",
        "terminal.ansi.blue": "#6397b3",
        "terminal.ansi.magenta": "#915a47",
        "terminal.ansi.cyan": "#5c8861",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#ea4848",
        "terminal.ansi.bright_green": "#878b36",
        "terminal.ansi.bright_yellow": "#a18e47",
        "terminal.ansi.bright_blue": "#50a7cf",
        "terminal.ansi.bright_magenta": "#ae5f3d",
        "terminal.ansi.bright_cyan": "#519a5b",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#7a7d48",
        "modified": "#8f8156",
        "deleted": "#c74e4e",
        "error": "#c74e4e",
        "warning": "#8f8156",
        "info": "#5988a3",
        "hint": "#5c8861",
        "syntax": {
          "comment": { "color": "#a59283", "font_style": "italic" },
          "string": { "color": "#7a7d48" },
          "string.regex": { "color": "#5c8861" },
          "number": { "color": "#875537" },
          "constant": { "color": "#875537" },
          "keyword": { "color": "#918c9d" },
          "function": { "color": "#5988a3" },
          "function.method": { "color": "#5988a3" },
          "type": { "color": "#8f8156" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#c74e4e" },
          "property": { "color": "#5c8861" },
          "operator": { "color": "#5c8861" },
          "punctuation": { "color": "#b0a193" },
          "tag": { "color": "#c74e4e" },
          "attribute": { "color": "#5c8861" },
          "title": { "color": "#5988a3", "font_weight": 700 },
          "link_uri": { "color": "#5c8861" },
          "link_text": { "color": "#c74e4e" }
        }
      }
    }
  ]
}