{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme BaseDarker",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme BaseDarker",
      "appearance": "dark",
      "style": {
        "background": "#1a2023",
        "editor.background": "#181e21",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#374646",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#1c2225",
        "editor.gutter.background": "#181e21",
        "text": "#5e8888",
        "text.muted": "#4d6263",
        "text.accent": "#447ca2",
        "border": "#1e2427",
        "surface.background": "#181e21",
        "elevated_surface.background": "#181e21",
        "element.background": "#1c2225",
        "element.hover": "#1e2427",
        "element.selected": "#1e2427",
        "element.active": "#1e2427",
        "element.disabled": "#1c2225",
        "ghost_element.background": "#1c2225",
        "ghost_element.hover": "#1e2427",
        "ghost_element.selected": "#1e2427",
        "ghost_element.active": "#1e2427",
        "ghost_element.disabled": "#1c2225",
        "drop_target.background": "#1e2427",
        "status_bar.background": "#1c2225",
        "title_bar.background": "#1c2225",
        "toolbar.background": "#181e21",
        "tab_bar.background": "#1c2225",
        "tab.active_background": "#181e21",
        "tab.inactive_background": "#1c2225",
        "panel.background": "#1c2225",
        "scrollbar.thumb.background": "#1e2427",
        "terminal.background": "#1a2023",
        "terminal.foreground": "#68a8a8",
        "terminal.ansi.black": "#161b1e",
        "terminal.ansi.red": "#d75e52",
        "terminal.ansi.green": "#7e965a",
        "terminal.ansi.yellow": "#d8b36f",
        "terminal.ansi.blue": "#3b6d8d",
        "terminal.ansi.magenta": "#c6614d",
        "terminal.ansi.cyan": "#448595",
        "terminal.ansi.white": "#4d6464",
        "terminal.ansi.bright_black": "#222e30",
        "terminal.ansi.bright_red": "#f06455",
        "terminal.ansi.bright_green": "#84a647",
        "terminal.ansi.bright_yellow": "#f0bf51",
        "terminal.ansi.bright_blue": "#237ca8",
        "terminal.ansi.bright_magenta": "#ea5f3a",
        "terminal.ansi.bright_cyan": "#2595ab",
        "terminal.ansi.bright_white": "#536f6f",
        "created": "#7e965a",
        "modified": "#d8b36f",
        "deleted": "#d75e52",
        "error": "#d75e52",
        "warning": "#d8b36f",
        "info": "#447ca2",
        "hint": "#448595",
        "syntax": {
          "comment": { "color": "#4d6263", "font_style": "italic" },
          "string": { "color": "#7e965a" },
          "string.regex": { "color": "#448595" },
          "number": { "color": "#e19556" },
          "constant": { "color": "#e19556" },
          "keyword": { "color": "#40719a" },
          "function": { "color": "#447ca2" },
          "function.method": { "color": "#447ca2" },
          "type": { "color": "#d8b36f" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#d75e52" },
          "property": { "color": "#448595" },
          "operator": { "color": "#448595" },
          "punctuation": { "color": "#374646" },
          "tag": { "color": "#d75e52" },
          "attribute": { "color": "#448595" },
          "title": { "color": "#447ca2", "font_weight": 700 },
          "link_uri": { "color": "#448595" },
          "link_text": { "color": "#d75e52" }
        }
      }
    }
  ]
}