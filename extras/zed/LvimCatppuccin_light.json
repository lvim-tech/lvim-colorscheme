{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Lvim Colorscheme CatppuccinLight",
  "author": "lvim-tech",
  "themes": [
    {
      "name": "Lvim Colorscheme CatppuccinLight",
      "appearance": "light",
      "style": {
        "background": "#dfdfdf",
        "editor.background": "#dadada",
        "editor.foreground": "#5e8888",
        "editor.line_number": "#62656f",
        "editor.active_line_number": "#55a6ab",
        "editor.active_line.background": "#E4E4E4",
        "editor.gutter.background": "#dadada",
        "text": "#5e8888",
        "text.muted": "#727897",
        "text.accent": "#6279a4",
        "border": "#e9e9e9",
        "surface.background": "#dadada",
        "elevated_surface.background": "#dadada",
        "element.background": "#E4E4E4",
        "element.hover": "#e9e9e9",
        "element.selected": "#e9e9e9",
        "ghost_element.hover": "#e9e9e9",
        "drop_target.background": "#e9e9e9",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "toolbar.background": "#dadada",
        "tab_bar.background": "#E4E4E4",
        "tab.active_background": "#dadada",
        "tab.inactive_background": "#E4E4E4",
        "panel.background": "#E4E4E4",
        "scrollbar.thumb.background": "#e9e9e9",
        "terminal.background": "#dfdfdf",
        "terminal.foreground": "#425353",
        "terminal.ansi.black": "#b6b6b6",
        "terminal.ansi.red": "#a45a6d",
        "terminal.ansi.green": "#557153",
        "terminal.ansi.yellow": "#8a7b5e",
        "terminal.ansi.blue": "#6d86ba",
        "terminal.ansi.magenta": "#845377",
        "terminal.ansi.cyan": "#557278",
        "terminal.ansi.white": "#619494",
        "terminal.ansi.bright_black": "#cfd1d1",
        "terminal.ansi.bright_red": "#cc5377",
        "terminal.ansi.bright_green": "#50824c",
        "terminal.ansi.bright_yellow": "#9e8754",
        "terminal.ansi.bright_blue": "#6d93d9",
        "terminal.ansi.bright_magenta": "#a65092",
        "terminal.ansi.bright_cyan": "#4e828b",
        "terminal.ansi.bright_white": "#5d8989",
        "created": "#557153",
        "modified": "#8a7b5e",
        "deleted": "#a45a6d",
        "error": "#a45a6d",
        "warning": "#8a7b5e",
        "info": "#6279a4",
        "hint": "#557278",
        "syntax": {
          "comment": { "color": "#727897", "font_style": "italic" },
          "string": { "color": "#557153" },
          "string.regex": { "color": "#557278" },
          "number": { "color": "#ac8068" },
          "constant": { "color": "#ac8068" },
          "keyword": { "color": "#9078ad" },
          "function": { "color": "#6279a4" },
          "function.method": { "color": "#6279a4" },
          "type": { "color": "#8a7b5e" },
          "variable": { "color": "#5e8888" },
          "variable.special": { "color": "#a45a6d" },
          "property": { "color": "#557278" },
          "operator": { "color": "#557278" },
          "punctuation": { "color": "#62656f" },
          "tag": { "color": "#a45a6d" },
          "attribute": { "color": "#557278" },
          "title": { "color": "#6279a4", "font_weight": 700 },
          "link_uri": { "color": "#557278" },
          "link_text": { "color": "#a45a6d" }
        }
      }
    }
  ]
}