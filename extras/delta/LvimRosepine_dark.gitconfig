[delta]
    syntax-theme = LvimRosepine_dark
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#9084a2"
    commit-decoration-style = "#837597" ol
    commit-style = raw
    blame-separator-style = "#a17699"
    hunk-header-decoration-style = "#a98a89" ul
    hunk-header-file-style = "#788b7c"
    hunk-header-line-number-style = "#718875"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#272226"
    minus-non-emph-style = syntax "#272226"
    minus-emph-style = syntax "#3c1837"
    minus-empty-line-marker-style = syntax "#272226"
    line-numbers-minus-style = "#a77681"
    plus-style = syntax "#242426"
    plus-non-emph-style = syntax "#242426"
    plus-emph-style = syntax "#202053"
    plus-empty-line-marker-style = syntax "#242426"
    line-numbers-plus-style = "#788b7c"
    line-numbers-zero-style = "#b3afb2"
    whitespace-error-style = "#84818e"
    merge-conflict-ours-diff-header-style = "#b6a18b" bold
    merge-conflict-theirs-diff-header-style = "#ac9682" bold overline
    map-styles = \
        bold purple => syntax "#1b191d", \
        bold blue => syntax "#19171b", \
        bold cyan => syntax "#1f1d21", \
        bold yellow => syntax "#211f23"