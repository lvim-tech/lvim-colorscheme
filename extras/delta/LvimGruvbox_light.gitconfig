[delta]
    syntax-theme = LvimGruvbox_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#915a47"
    commit-decoration-style = "#a7614a" ol
    commit-style = raw
    blame-separator-style = "#a59283"
    hunk-header-decoration-style = "#875537" ul
    hunk-header-file-style = "#7a7d48"
    hunk-header-line-number-style = "#8a8e52"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#e2d8d8"
    minus-non-emph-style = syntax "#e2d8d8"
    minus-emph-style = syntax "#f5d6d6"
    minus-empty-line-marker-style = syntax "#e2d8d8"
    line-numbers-minus-style = "#c74e4e"
    plus-style = syntax "#dcdcd8"
    plus-non-emph-style = syntax "#dcdcd8"
    plus-emph-style = syntax "#e3e398"
    plus-empty-line-marker-style = syntax "#dcdcd8"
    line-numbers-plus-style = "#7a7d48"
    line-numbers-zero-style = "#5e8888"
    whitespace-error-style = "#918c9d"
    merge-conflict-ours-diff-header-style = "#8f8156" bold
    merge-conflict-theirs-diff-header-style = "#988857" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"