[delta]
    syntax-theme = LvimTokyonight_dark
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#907bba"
    commit-decoration-style = "#826cb1" ol
    commit-style = raw
    blame-separator-style = "#7d85a9"
    hunk-header-decoration-style = "#bb866d" ul
    hunk-header-file-style = "#7a8d68"
    hunk-header-line-number-style = "#758c5f"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#2a252e"
    minus-non-emph-style = syntax "#2a252e"
    minus-emph-style = syntax "#3a1b4b"
    minus-empty-line-marker-style = syntax "#2a252e"
    line-numbers-minus-style = "#c86b7b"
    plus-style = syntax "#24282d"
    plus-non-emph-style = syntax "#24282d"
    plus-emph-style = syntax "#172b3e"
    plus-empty-line-marker-style = syntax "#24282d"
    line-numbers-plus-style = "#7a8d68"
    line-numbers-zero-style = "#b2b6c7"
    whitespace-error-style = "#8f7eac"
    merge-conflict-ours-diff-header-style = "#b79d7b" bold
    merge-conflict-theirs-diff-header-style = "#ad9170" bold overline
    map-styles = \
        bold purple => syntax "#1b1e26", \
        bold blue => syntax "#191c24", \
        bold cyan => syntax "#1f222a", \
        bold yellow => syntax "#21242c"