[delta]
    syntax-theme = LvimTokyonight_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#6d5599"
    commit-decoration-style = "#816ab0" ol
    commit-style = raw
    blame-separator-style = "#5e6278"
    hunk-header-decoration-style = "#785c50" ul
    hunk-header-file-style = "#5a674e"
    hunk-header-line-number-style = "#5a664e"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#dfd9da"
    minus-non-emph-style = syntax "#dfd9da"
    minus-emph-style = syntax "#f3d6db"
    minus-empty-line-marker-style = syntax "#dfd9da"
    line-numbers-minus-style = "#904f5b"
    plus-style = syntax "#d9dbd8"
    plus-non-emph-style = syntax "#d9dbd8"
    plus-emph-style = syntax "#b9ec98"
    plus-empty-line-marker-style = syntax "#d9dbd8"
    line-numbers-plus-style = "#5a674e"
    line-numbers-zero-style = "#4e6767"
    whitespace-error-style = "#675c7a"
    merge-conflict-ours-diff-header-style = "#6e6050" bold
    merge-conflict-theirs-diff-header-style = "#6e6050" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"