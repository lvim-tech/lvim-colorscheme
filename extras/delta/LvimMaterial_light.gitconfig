[delta]
    syntax-theme = LvimMaterial_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#a14351"
    commit-decoration-style = "#c7495c" ol
    commit-style = raw
    blame-separator-style = "#5a6267"
    hunk-header-decoration-style = "#86564a" ul
    hunk-header-file-style = "#596846"
    hunk-header-line-number-style = "#596846"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#e0d8d8"
    minus-non-emph-style = syntax "#e0d8d8"
    minus-emph-style = syntax "#f4d6d6"
    minus-empty-line-marker-style = syntax "#e0d8d8"
    line-numbers-minus-style = "#9d474c"
    plus-style = syntax "#dbdcd8"
    plus-non-emph-style = syntax "#dbdcd8"
    plus-emph-style = syntax "#d6e698"
    plus-empty-line-marker-style = syntax "#dbdcd8"
    line-numbers-plus-style = "#596846"
    line-numbers-zero-style = "#4e6767"
    whitespace-error-style = "#6d597d"
    merge-conflict-ours-diff-header-style = "#746042" bold
    merge-conflict-theirs-diff-header-style = "#755f42" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"