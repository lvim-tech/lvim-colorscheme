[delta]
    syntax-theme = LvimSolarized_dark
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#c0578a"
    commit-decoration-style = "#b14d7d" ol
    commit-style = raw
    blame-separator-style = "#5d6a6f"
    hunk-header-decoration-style = "#b46548" ul
    hunk-header-file-style = "#727c3e"
    hunk-header-line-number-style = "#666f37"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#102e38"
    minus-non-emph-style = syntax "#102e38"
    minus-emph-style = syntax "#00313e"
    minus-empty-line-marker-style = syntax "#102e38"
    line-numbers-minus-style = "#c24f4d"
    plus-style = syntax "#093137"
    plus-non-emph-style = syntax "#093137"
    plus-emph-style = syntax "#00343b"
    plus-empty-line-marker-style = syntax "#093137"
    line-numbers-plus-style = "#727c3e"
    line-numbers-zero-style = "#9da4a4"
    whitespace-error-style = "#757797"
    merge-conflict-ours-diff-header-style = "#9f8549" bold
    merge-conflict-theirs-diff-header-style = "#917b43" bold overline
    map-styles = \
        bold purple => syntax "#002934", \
        bold blue => syntax "#002732", \
        bold cyan => syntax "#022d38", \
        bold yellow => syntax "#042f3a"