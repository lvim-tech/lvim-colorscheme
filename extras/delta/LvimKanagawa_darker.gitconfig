[delta]
    syntax-theme = LvimKanagawa_darker
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#c4726c"
    commit-decoration-style = "#bc6a64" ol
    commit-style = raw
    blame-separator-style = "#8181b2"
    hunk-header-decoration-style = "#bf8f62" ul
    hunk-header-file-style = "#748a58"
    hunk-header-line-number-style = "#748b55"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#292127"
    minus-non-emph-style = syntax "#292127"
    minus-emph-style = syntax "#3e1637"
    minus-empty-line-marker-style = syntax "#292127"
    line-numbers-minus-style = "#d35f5f"
    plus-style = syntax "#222527"
    plus-non-emph-style = syntax "#222527"
    plus-emph-style = syntax "#162932"
    plus-empty-line-marker-style = syntax "#222527"
    line-numbers-plus-style = "#748a58"
    line-numbers-zero-style = "#80809f"
    whitespace-error-style = "#897ea6"
    merge-conflict-ours-diff-header-style = "#d1b57c" bold
    merge-conflict-theirs-diff-header-style = "#cbae75" bold overline
    map-styles = \
        bold purple => syntax "#1a1b21", \
        bold blue => syntax "#18191f", \
        bold cyan => syntax "#1e1f25", \
        bold yellow => syntax "#202127"