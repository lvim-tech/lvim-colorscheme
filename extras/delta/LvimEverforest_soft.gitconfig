[delta]
    syntax-theme = LvimEverforest_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#cc7d62"
    commit-decoration-style = "#b3664c" ol
    commit-style = raw
    blame-separator-style = "#809873"
    hunk-header-decoration-style = "#d07b41" ul
    hunk-header-file-style = "#92962d"
    hunk-header-line-number-style = "#909600"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#363235"
    minus-non-emph-style = syntax "#363235"
    minus-emph-style = syntax "#522549"
    minus-empty-line-marker-style = syntax "#363235"
    line-numbers-minus-style = "#e36a6a"
    plus-style = syntax "#2f3534"
    plus-non-emph-style = syntax "#2f3534"
    plus-emph-style = syntax "#1d3b37"
    plus-empty-line-marker-style = syntax "#2f3534"
    line-numbers-plus-style = "#92962d"
    line-numbers-zero-style = "#869682"
    whitespace-error-style = "#938ca4"
    merge-conflict-ours-diff-header-style = "#af9e6b" bold
    merge-conflict-theirs-diff-header-style = "#a6935a" bold overline
    map-styles = \
        bold purple => syntax "#252a2d", \
        bold blue => syntax "#202527", \
        bold cyan => syntax "#2d3439", \
        bold yellow => syntax "#32393f"