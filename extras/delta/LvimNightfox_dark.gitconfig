[delta]
    syntax-theme = LvimNightfox_dark
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#9a80ae"
    commit-decoration-style = "#8d70a4" ol
    commit-style = raw
    blame-separator-style = "#758292"
    hunk-header-decoration-style = "#c88e62" ul
    hunk-header-file-style = "#7b998a"
    hunk-header-line-number-style = "#6a8b7b"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#252836"
    minus-non-emph-style = syntax "#252836"
    minus-emph-style = syntax "#182855"
    minus-empty-line-marker-style = syntax "#252836"
    line-numbers-minus-style = "#b26377"
    plus-style = syntax "#212c37"
    plus-non-emph-style = syntax "#212c37"
    plus-emph-style = syntax "#093048"
    plus-empty-line-marker-style = syntax "#212c37"
    line-numbers-plus-style = "#7b998a"
    line-numbers-zero-style = "#bcbdbd"
    whitespace-error-style = "#8670a7"
    merge-conflict-ours-diff-header-style = "#bba76f" bold
    merge-conflict-theirs-diff-header-style = "#b19c63" bold overline
    map-styles = \
        bold purple => syntax "#17212e", \
        bold blue => syntax "#151f2c", \
        bold cyan => syntax "#1b2532", \
        bold yellow => syntax "#1d2734"