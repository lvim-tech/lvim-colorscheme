[delta]
    syntax-theme = LvimDracula_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#c578a1"
    commit-decoration-style = "#b4618c" ol
    commit-style = raw
    blame-separator-style = "#878fad"
    hunk-header-decoration-style = "#b58f70" ul
    hunk-header-file-style = "#659f72"
    hunk-header-line-number-style = "#61a06c"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#352f39"
    minus-non-emph-style = syntax "#352f39"
    minus-emph-style = syntax "#49235a"
    minus-empty-line-marker-style = syntax "#352f39"
    line-numbers-minus-style = "#cd7878"
    plus-style = syntax "#2e343a"
    plus-non-emph-style = syntax "#2e343a"
    plus-emph-style = syntax "#1c384c"
    plus-empty-line-marker-style = syntax "#2e343a"
    line-numbers-plus-style = "#659f72"
    line-numbers-zero-style = "#c7c7b3"
    whitespace-error-style = "#9d88bb"
    merge-conflict-ours-diff-header-style = "#adb27e" bold
    merge-conflict-theirs-diff-header-style = "#a3a975" bold overline
    map-styles = \
        bold purple => syntax "#272934", \
        bold blue => syntax "#252732", \
        bold cyan => syntax "#2b2d38", \
        bold yellow => syntax "#2d2f3a"