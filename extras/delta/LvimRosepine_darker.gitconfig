[delta]
    syntax-theme = LvimRosepine_darker
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#9084a2"
    commit-decoration-style = "#837597" ol
    commit-style = raw
    blame-separator-style = "#9a7292"
    hunk-header-decoration-style = "#a98a89" ul
    hunk-header-file-style = "#788b7c"
    hunk-header-line-number-style = "#6f8573"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#221c21"
    minus-non-emph-style = syntax "#221c21"
    minus-emph-style = syntax "#351330"
    minus-empty-line-marker-style = syntax "#221c21"
    line-numbers-minus-style = "#a0727c"
    plus-style = syntax "#1f1e21"
    plus-non-emph-style = syntax "#1f1e21"
    plus-emph-style = syntax "#29183f"
    plus-empty-line-marker-style = syntax "#1f1e21"
    line-numbers-plus-style = "#788b7c"
    line-numbers-zero-style = "#b3afb2"
    whitespace-error-style = "#7f7c89"
    merge-conflict-ours-diff-header-style = "#b6a18b" bold
    merge-conflict-theirs-diff-header-style = "#ac9682" bold overline
    map-styles = \
        bold purple => syntax "#151317", \
        bold blue => syntax "#131115", \
        bold cyan => syntax "#19171b", \
        bold yellow => syntax "#1b191d"