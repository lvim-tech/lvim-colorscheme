[delta]
    syntax-theme = LvimRosepine_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#9084a2"
    commit-decoration-style = "#837597" ol
    commit-style = raw
    blame-separator-style = "#896882"
    hunk-header-decoration-style = "#a98a89" ul
    hunk-header-file-style = "#788b7c"
    hunk-header-line-number-style = "#697d6d"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#2d272d"
    minus-non-emph-style = syntax "#2d272d"
    minus-emph-style = syntax "#431c43"
    minus-empty-line-marker-style = syntax "#2d272d"
    line-numbers-minus-style = "#a0727c"
    plus-style = syntax "#2a292d"
    plus-non-emph-style = syntax "#2a292d"
    plus-emph-style = syntax "#332254"
    plus-empty-line-marker-style = syntax "#2a292d"
    line-numbers-plus-style = "#788b7c"
    line-numbers-zero-style = "#b3afb2"
    whitespace-error-style = "#726f7c"
    merge-conflict-ours-diff-header-style = "#b6a18b" bold
    merge-conflict-theirs-diff-header-style = "#ac9682" bold overline
    map-styles = \
        bold purple => syntax "#211f24", \
        bold blue => syntax "#1f1d22", \
        bold cyan => syntax "#252328", \
        bold yellow => syntax "#27252a"