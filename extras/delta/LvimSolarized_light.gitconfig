[delta]
    syntax-theme = LvimSolarized_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#b35181"
    commit-decoration-style = "#c7578d" ol
    commit-style = raw
    blame-separator-style = "#798890"
    hunk-header-decoration-style = "#ab6044" ul
    hunk-header-file-style = "#727c3e"
    hunk-header-line-number-style = "#7f8a46"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#e2d8d8"
    minus-non-emph-style = syntax "#e2d8d8"
    minus-emph-style = syntax "#f5d6d6"
    minus-empty-line-marker-style = syntax "#e2d8d8"
    line-numbers-minus-style = "#ca5350"
    plus-style = syntax "#dbdcd7"
    plus-non-emph-style = syntax "#dbdcd7"
    plus-emph-style = syntax "#d9e697"
    plus-empty-line-marker-style = syntax "#dbdcd7"
    line-numbers-plus-style = "#727c3e"
    line-numbers-zero-style = "#5e8888"
    whitespace-error-style = "#707293"
    merge-conflict-ours-diff-header-style = "#786435" bold
    merge-conflict-theirs-diff-header-style = "#836f3c" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"