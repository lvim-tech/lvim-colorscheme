[delta]
    syntax-theme = LvimDracula_darker
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#bf6f9a"
    commit-decoration-style = "#b4618c" ol
    commit-style = raw
    blame-separator-style = "#7c84a3"
    hunk-header-decoration-style = "#b58f70" ul
    hunk-header-file-style = "#62966d"
    hunk-header-line-number-style = "#5c9165"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#2a242c"
    minus-non-emph-style = syntax "#2a242c"
    minus-emph-style = syntax "#3d1a45"
    minus-empty-line-marker-style = syntax "#2a242c"
    line-numbers-minus-style = "#c76b6b"
    plus-style = syntax "#23292d"
    plus-non-emph-style = syntax "#23292d"
    plus-emph-style = syntax "#142d39"
    plus-empty-line-marker-style = syntax "#23292d"
    line-numbers-plus-style = "#62966d"
    line-numbers-zero-style = "#c7c7b3"
    whitespace-error-style = "#937db1"
    merge-conflict-ours-diff-header-style = "#adb27e" bold
    merge-conflict-theirs-diff-header-style = "#a3a975" bold overline
    map-styles = \
        bold purple => syntax "#1b1d25", \
        bold blue => syntax "#191b23", \
        bold cyan => syntax "#1f2129", \
        bold yellow => syntax "#21232b"