[delta]
    syntax-theme = LvimNightfox_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#9d83b0"
    commit-decoration-style = "#8d70a4" ol
    commit-style = raw
    blame-separator-style = "#808fa2"
    hunk-header-decoration-style = "#c88e62" ul
    hunk-header-file-style = "#7b998a"
    hunk-header-line-number-style = "#6f9482"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#292d3c"
    minus-non-emph-style = syntax "#292d3c"
    minus-emph-style = syntax "#1a2e5b"
    minus-empty-line-marker-style = syntax "#292d3c"
    line-numbers-minus-style = "#c77489"
    plus-style = syntax "#25313e"
    plus-non-emph-style = syntax "#25313e"
    plus-emph-style = syntax "#0a3551"
    plus-empty-line-marker-style = syntax "#25313e"
    line-numbers-plus-style = "#7b998a"
    line-numbers-zero-style = "#bcbdbd"
    whitespace-error-style = "#9882b9"
    merge-conflict-ours-diff-header-style = "#bba76f" bold
    merge-conflict-theirs-diff-header-style = "#b19c63" bold overline
    map-styles = \
        bold purple => syntax "#1b2635", \
        bold blue => syntax "#192433", \
        bold cyan => syntax "#1f2a39", \
        bold yellow => syntax "#212c3b"