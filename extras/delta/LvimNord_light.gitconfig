[delta]
    syntax-theme = LvimNord_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#6e5a6b"
    commit-decoration-style = "#7f667a" ol
    commit-style = raw
    blame-separator-style = "#5b6271"
    hunk-header-decoration-style = "#7a564b" ul
    hunk-header-file-style = "#5b6454"
    hunk-header-line-number-style = "#57654c"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#ded9da"
    minus-non-emph-style = syntax "#ded9da"
    minus-emph-style = syntax "#f2d6dc"
    minus-empty-line-marker-style = syntax "#ded9da"
    line-numbers-minus-style = "#84575b"
    plus-style = syntax "#dcdddb"
    plus-non-emph-style = syntax "#dcdddb"
    plus-emph-style = syntax "#c8eb9b"
    plus-empty-line-marker-style = syntax "#dcdddb"
    line-numbers-plus-style = "#5b6454"
    line-numbers-zero-style = "#4e6767"
    whitespace-error-style = "#665f70"
    merge-conflict-ours-diff-header-style = "#6f6146" bold
    merge-conflict-theirs-diff-header-style = "#706146" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"