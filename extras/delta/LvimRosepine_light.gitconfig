[delta]
    syntax-theme = LvimRosepine_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#6a5d7d"
    commit-decoration-style = "#7b6d90" ol
    commit-style = raw
    blame-separator-style = "#745c6e"
    hunk-header-decoration-style = "#735e5d" ul
    hunk-header-file-style = "#57645a"
    hunk-header-line-number-style = "#58665a"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#dddadb"
    minus-non-emph-style = syntax "#dddadb"
    minus-emph-style = syntax "#f1d7e0"
    minus-empty-line-marker-style = syntax "#dddadb"
    line-numbers-minus-style = "#795960"
    plus-style = syntax "#d9dad9"
    plus-non-emph-style = syntax "#d9dad9"
    plus-emph-style = syntax "#9cf09c"
    plus-empty-line-marker-style = syntax "#d9dad9"
    line-numbers-plus-style = "#57645a"
    line-numbers-zero-style = "#4e6767"
    whitespace-error-style = "#63616c"
    merge-conflict-ours-diff-header-style = "#6c6156" bold
    merge-conflict-theirs-diff-header-style = "#6b6056" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"