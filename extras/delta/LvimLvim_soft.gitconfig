[delta]
    syntax-theme = LvimLvim_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#c75940"
    commit-decoration-style = "#b84e36" ol
    commit-style = raw
    blame-separator-style = "#4d6263"
    hunk-header-decoration-style = "#FF9C2A" ul
    hunk-header-file-style = "#8AA55F"
    hunk-header-line-number-style = "#7d9654"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#353133"
    minus-non-emph-style = syntax "#353133"
    minus-emph-style = syntax "#532440"
    minus-empty-line-marker-style = syntax "#353133"
    line-numbers-minus-style = "#e65e4f"
    plus-style = syntax "#2e3735"
    plus-non-emph-style = syntax "#2e3735"
    plus-emph-style = syntax "#1a3d37"
    plus-empty-line-marker-style = syntax "#2e3735"
    line-numbers-plus-style = "#8AA55F"
    line-numbers-zero-style = "#5e8888"
    whitespace-error-style = "#177ab3"
    merge-conflict-ours-diff-header-style = "#edc060" bold
    merge-conflict-theirs-diff-header-style = "#eab749" bold overline
    map-styles = \
        bold purple => syntax "#22272b", \
        bold blue => syntax "#1e2325", \
        bold cyan => syntax "#313a40", \
        bold yellow => syntax "#3c474f"