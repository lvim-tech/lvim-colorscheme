[delta]
    syntax-theme = LvimLvim_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#c6614d"
    commit-decoration-style = "#b65745" ol
    commit-style = raw
    blame-separator-style = "#4d6263"
    hunk-header-decoration-style = "#e19556" ul
    hunk-header-file-style = "#7e965a"
    hunk-header-line-number-style = "#718650"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#343134"
    minus-non-emph-style = syntax "#343134"
    minus-emph-style = syntax "#4d254d"
    minus-empty-line-marker-style = syntax "#343134"
    line-numbers-minus-style = "#d75e52"
    plus-style = syntax "#2d3534"
    plus-non-emph-style = syntax "#2d3534"
    plus-emph-style = syntax "#1a3b38"
    plus-empty-line-marker-style = syntax "#2d3534"
    line-numbers-plus-style = "#7e965a"
    line-numbers-zero-style = "#5e8888"
    whitespace-error-style = "#40719a"
    merge-conflict-ours-diff-header-style = "#d8b36f" bold
    merge-conflict-theirs-diff-header-style = "#d1aa64" bold overline
    map-styles = \
        bold purple => syntax "#242b2f", \
        bold blue => syntax "#22292d", \
        bold cyan => syntax "#282f33", \
        bold yellow => syntax "#2a3135"