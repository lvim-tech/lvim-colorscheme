[delta]
    syntax-theme = LvimKanagawa_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#92534e"
    commit-decoration-style = "#9b5652" ol
    commit-style = raw
    blame-separator-style = "#9d9db5"
    hunk-header-decoration-style = "#a5794e" ul
    hunk-header-file-style = "#677951"
    hunk-header-line-number-style = "#6d7f55"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#e2d9d9"
    minus-non-emph-style = syntax "#e2d9d9"
    minus-emph-style = syntax "#f5d7d7"
    minus-empty-line-marker-style = syntax "#e2d9d9"
    line-numbers-minus-style = "#c85b5b"
    plus-style = syntax "#dadbd8"
    plus-non-emph-style = syntax "#dadbd8"
    plus-emph-style = syntax "#d0e698"
    plus-empty-line-marker-style = syntax "#dadbd8"
    line-numbers-plus-style = "#677951"
    line-numbers-zero-style = "#5e8888"
    whitespace-error-style = "#82789b"
    merge-conflict-ours-diff-header-style = "#776745" bold
    merge-conflict-theirs-diff-header-style = "#7b6943" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"