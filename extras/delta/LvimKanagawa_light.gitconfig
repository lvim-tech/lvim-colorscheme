[delta]
    syntax-theme = LvimKanagawa_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#94544f"
    commit-decoration-style = "#a05954" ol
    commit-style = raw
    blame-separator-style = "#9d9db5"
    hunk-header-decoration-style = "#a87e56" ul
    hunk-header-file-style = "#697b51"
    hunk-header-line-number-style = "#728559"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#e1d9d9"
    minus-non-emph-style = syntax "#e1d9d9"
    minus-emph-style = syntax "#f4d7d7"
    minus-empty-line-marker-style = syntax "#e1d9d9"
    line-numbers-minus-style = "#c35959"
    plus-style = syntax "#dadcd8"
    plus-non-emph-style = syntax "#dadcd8"
    plus-emph-style = syntax "#c6ea98"
    plus-empty-line-marker-style = syntax "#dadcd8"
    line-numbers-plus-style = "#697b51"
    line-numbers-zero-style = "#5e8888"
    whitespace-error-style = "#887fa0"
    merge-conflict-ours-diff-header-style = "#816f4a" bold
    merge-conflict-theirs-diff-header-style = "#87734c" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"