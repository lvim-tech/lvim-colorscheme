[delta]
    syntax-theme = LvimKanagawa_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#c4746e"
    commit-decoration-style = "#c16d67" ol
    commit-style = raw
    blame-separator-style = "#4e4e73"
    hunk-header-decoration-style = "#c99460" ul
    hunk-header-file-style = "#6e8156"
    hunk-header-line-number-style = "#697b52"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#322a30"
    minus-non-emph-style = syntax "#322a30"
    minus-emph-style = syntax "#4b1d42"
    minus-empty-line-marker-style = syntax "#322a30"
    line-numbers-minus-style = "#b65252"
    plus-style = syntax "#2c2e30"
    plus-non-emph-style = syntax "#2c2e30"
    plus-emph-style = syntax "#1f3240"
    plus-empty-line-marker-style = syntax "#2c2e30"
    line-numbers-plus-style = "#6e8156"
    line-numbers-zero-style = "#54546d"
    whitespace-error-style = "#766b90"
    merge-conflict-ours-diff-header-style = "#e0c286" bold
    merge-conflict-theirs-diff-header-style = "#debe7e" bold overline
    map-styles = \
        bold purple => syntax "#212227", \
        bold blue => syntax "#1d1e22", \
        bold cyan => syntax "#2b2c33", \
        bold yellow => syntax "#2f3038"