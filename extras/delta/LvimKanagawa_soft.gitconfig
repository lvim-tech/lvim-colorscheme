[delta]
    syntax-theme = LvimKanagawa_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#c4726c"
    commit-decoration-style = "#bc6a64" ol
    commit-style = raw
    blame-separator-style = "#4e4e73"
    hunk-header-decoration-style = "#bf8f62" ul
    hunk-header-file-style = "#6c7f54"
    hunk-header-line-number-style = "#64754e"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#322b30"
    minus-non-emph-style = syntax "#322b30"
    minus-emph-style = syntax "#4c1e42"
    minus-empty-line-marker-style = syntax "#322b30"
    line-numbers-minus-style = "#ba5454"
    plus-style = syntax "#2c2e30"
    plus-non-emph-style = syntax "#2c2e30"
    plus-emph-style = syntax "#1f3240"
    plus-empty-line-marker-style = syntax "#2c2e30"
    line-numbers-plus-style = "#6c7f54"
    line-numbers-zero-style = "#54546d"
    whitespace-error-style = "#70658b"
    merge-conflict-ours-diff-header-style = "#d1b57c" bold
    merge-conflict-theirs-diff-header-style = "#cbae75" bold overline
    map-styles = \
        bold purple => syntax "#24252b", \
        bold blue => syntax "#222329", \
        bold cyan => syntax "#28292f", \
        bold yellow => syntax "#2a2b31"