[delta]
    syntax-theme = LvimCatppuccin_dark
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#b976a7"
    commit-decoration-style = "#a96b96" ol
    commit-style = raw
    blame-separator-style = "#7e85a6"
    hunk-header-decoration-style = "#b88970" ul
    hunk-header-file-style = "#6b8d69"
    hunk-header-line-number-style = "#638f61"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#29242e"
    minus-non-emph-style = syntax "#29242e"
    minus-emph-style = syntax "#381a4c"
    minus-empty-line-marker-style = syntax "#29242e"
    line-numbers-minus-style = "#c26b81"
    plus-style = syntax "#23272c"
    plus-non-emph-style = syntax "#23272c"
    plus-emph-style = syntax "#162a3c"
    plus-empty-line-marker-style = syntax "#23272c"
    line-numbers-plus-style = "#6b8d69"
    line-numbers-zero-style = "#b2b7c7"
    whitespace-error-style = "#9679b9"
    merge-conflict-ours-diff-header-style = "#b8a47e" bold
    merge-conflict-theirs-diff-header-style = "#af9973" bold overline
    map-styles = \
        bold purple => syntax "#1b1c25", \
        bold blue => syntax "#191a23", \
        bold cyan => syntax "#1f2029", \
        bold yellow => syntax "#21222b"