[delta]
    syntax-theme = LvimSolarized_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#e06fa5"
    commit-decoration-style = "#b14d7d" ol
    commit-style = raw
    blame-separator-style = "#809aa4"
    hunk-header-decoration-style = "#e27647" ul
    hunk-header-file-style = "#8f9d33"
    hunk-header-line-number-style = "#8e9e17"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#103642"
    minus-non-emph-style = syntax "#103642"
    minus-emph-style = syntax "#003948"
    minus-empty-line-marker-style = syntax "#103642"
    line-numbers-minus-style = "#e77371"
    plus-style = syntax "#093a41"
    plus-non-emph-style = syntax "#093a41"
    plus-emph-style = syntax "#003d45"
    plus-empty-line-marker-style = syntax "#093a41"
    line-numbers-plus-style = "#8f9d33"
    line-numbers-zero-style = "#9da4a4"
    whitespace-error-style = "#9293b3"
    merge-conflict-ours-diff-header-style = "#b09148" bold
    merge-conflict-theirs-diff-header-style = "#af913e" bold overline
    map-styles = \
        bold purple => syntax "#00323f", \
        bold blue => syntax "#00303d", \
        bold cyan => syntax "#023643", \
        bold yellow => syntax "#043845"