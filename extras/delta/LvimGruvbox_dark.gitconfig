[delta]
    syntax-theme = LvimGruvbox_dark
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#bb755e"
    commit-decoration-style = "#b1674f" ol
    commit-style = raw
    blame-separator-style = "#9b836d"
    hunk-header-decoration-style = "#c47d54" ul
    hunk-header-file-style = "#878b46"
    hunk-header-line-number-style = "#868b37"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#2f2524"
    minus-non-emph-style = syntax "#2f2524"
    minus-emph-style = syntax "#471d16"
    minus-empty-line-marker-style = syntax "#2f2524"
    line-numbers-minus-style = "#de5e5e"
    plus-style = syntax "#292823"
    plus-non-emph-style = syntax "#292823"
    plus-emph-style = syntax "#2e2a13"
    plus-empty-line-marker-style = syntax "#292823"
    line-numbers-plus-style = "#878b46"
    line-numbers-zero-style = "#958575"
    whitespace-error-style = "#8c849d"
    merge-conflict-ours-diff-header-style = "#af9e6b" bold
    merge-conflict-theirs-diff-header-style = "#a5935f" bold overline
    map-styles = \
        bold purple => syntax "#201f1e", \
        bold blue => syntax "#1e1d1c", \
        bold cyan => syntax "#242322", \
        bold yellow => syntax "#262524"