[delta]
    syntax-theme = LvimTokyonight_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#907bba"
    commit-decoration-style = "#826cb1" ol
    commit-style = raw
    blame-separator-style = "#616784"
    hunk-header-decoration-style = "#bb866d" ul
    hunk-header-file-style = "#788a67"
    hunk-header-line-number-style = "#697b58"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#2e2a33"
    minus-non-emph-style = syntax "#2e2a33"
    minus-emph-style = syntax "#3d2056"
    minus-empty-line-marker-style = syntax "#2e2a33"
    line-numbers-minus-style = "#bb6171"
    plus-style = syntax "#292d33"
    plus-non-emph-style = syntax "#292d33"
    plus-emph-style = syntax "#1b3047"
    plus-empty-line-marker-style = syntax "#292d33"
    line-numbers-plus-style = "#788a67"
    line-numbers-zero-style = "#b2b6c7"
    whitespace-error-style = "#73638e"
    merge-conflict-ours-diff-header-style = "#b79d7b" bold
    merge-conflict-theirs-diff-header-style = "#ad9170" bold overline
    map-styles = \
        bold purple => syntax "#20232c", \
        bold blue => syntax "#1e212a", \
        bold cyan => syntax "#242730", \
        bold yellow => syntax "#262932"