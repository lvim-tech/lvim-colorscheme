[delta]
    syntax-theme = LvimEverforest_darker
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#bb755e"
    commit-decoration-style = "#b3664c" ol
    commit-style = raw
    blame-separator-style = "#535d4e"
    hunk-header-decoration-style = "#cc7942" ul
    hunk-header-file-style = "#75783a"
    hunk-header-line-number-style = "#656831"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#2d282c"
    minus-non-emph-style = syntax "#2d282c"
    minus-emph-style = syntax "#441d3e"
    minus-empty-line-marker-style = syntax "#2d282c"
    line-numbers-minus-style = "#cb4f4f"
    plus-style = syntax "#262c2a"
    plus-non-emph-style = syntax "#262c2a"
    plus-emph-style = syntax "#16322a"
    plus-empty-line-marker-style = syntax "#262c2a"
    line-numbers-plus-style = "#75783a"
    line-numbers-zero-style = "#5a6158"
    whitespace-error-style = "#635d71"
    merge-conflict-ours-diff-header-style = "#af9e6b" bold
    merge-conflict-theirs-diff-header-style = "#a6935a" bold overline
    map-styles = \
        bold purple => syntax "#1b2023", \
        bold blue => syntax "#161b1d", \
        bold cyan => syntax "#232a2f", \
        bold yellow => syntax "#282f35"