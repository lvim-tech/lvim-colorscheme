[delta]
    syntax-theme = LvimCatppuccin_darker
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#b976a7"
    commit-decoration-style = "#a96b96" ol
    commit-style = raw
    blame-separator-style = "#7880a1"
    hunk-header-decoration-style = "#b88970" ul
    hunk-header-file-style = "#6b8d69"
    hunk-header-line-number-style = "#628c5f"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#251f27"
    minus-non-emph-style = syntax "#251f27"
    minus-emph-style = syntax "#36163e"
    minus-empty-line-marker-style = syntax "#251f27"
    line-numbers-minus-style = "#bb677c"
    plus-style = syntax "#1f2226"
    plus-non-emph-style = syntax "#1f2226"
    plus-emph-style = syntax "#142535"
    plus-empty-line-marker-style = syntax "#1f2226"
    line-numbers-plus-style = "#6b8d69"
    line-numbers-zero-style = "#b2b7c7"
    whitespace-error-style = "#9173b3"
    merge-conflict-ours-diff-header-style = "#b8a47e" bold
    merge-conflict-theirs-diff-header-style = "#af9973" bold overline
    map-styles = \
        bold purple => syntax "#16171e", \
        bold blue => syntax "#14151c", \
        bold cyan => syntax "#1a1b22", \
        bold yellow => syntax "#1c1d24"