[delta]
    syntax-theme = LvimBase_darker
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#d5654e"
    commit-decoration-style = "#b65745" ol
    commit-style = raw
    blame-separator-style = "#638e8f"
    hunk-header-decoration-style = "#e19556" ul
    hunk-header-file-style = "#7e965a"
    hunk-header-line-number-style = "#778e52"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#2b2729"
    minus-non-emph-style = syntax "#2b2729"
    minus-emph-style = syntax "#451c34"
    minus-empty-line-marker-style = syntax "#2b2729"
    line-numbers-minus-style = "#dc5f52"
    plus-style = syntax "#242b29"
    plus-non-emph-style = syntax "#242b29"
    plus-emph-style = syntax "#14312a"
    plus-empty-line-marker-style = syntax "#242b29"
    line-numbers-plus-style = "#7e965a"
    line-numbers-zero-style = "#608e8e"
    whitespace-error-style = "#378cc8"
    merge-conflict-ours-diff-header-style = "#d8b36f" bold
    merge-conflict-theirs-diff-header-style = "#d1aa64" bold overline
    map-styles = \
        bold purple => syntax "#1a2023", \
        bold blue => syntax "#181e21", \
        bold cyan => syntax "#1e2427", \
        bold yellow => syntax "#202629"