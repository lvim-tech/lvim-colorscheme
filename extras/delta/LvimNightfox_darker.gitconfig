[delta]
    syntax-theme = LvimNightfox_darker
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#9b82af"
    commit-decoration-style = "#8e71a4" ol
    commit-style = raw
    blame-separator-style = "#758292"
    hunk-header-decoration-style = "#d49360" ul
    hunk-header-file-style = "#89aa9a"
    hunk-header-line-number-style = "#799e8c"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#21222d"
    minus-non-emph-style = syntax "#21222d"
    minus-emph-style = syntax "#192050"
    minus-empty-line-marker-style = syntax "#21222d"
    line-numbers-minus-style = "#b46478"
    plus-style = syntax "#1d272f"
    plus-non-emph-style = syntax "#1d272f"
    plus-emph-style = syntax "#082b3d"
    plus-empty-line-marker-style = syntax "#1d272f"
    line-numbers-plus-style = "#89aa9a"
    line-numbers-zero-style = "#bcbdbd"
    whitespace-error-style = "#9380b2"
    merge-conflict-ours-diff-header-style = "#c1ac71" bold
    merge-conflict-theirs-diff-header-style = "#b9a15e" bold overline
    map-styles = \
        bold purple => syntax "#10161e", \
        bold blue => syntax "#0e131a", \
        bold cyan => syntax "#1c2735", \
        bold yellow => syntax "#243245"