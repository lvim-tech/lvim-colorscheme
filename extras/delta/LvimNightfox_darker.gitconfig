[delta]
    syntax-theme = LvimNightfox_darker
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#9a80ae"
    commit-decoration-style = "#8d70a4" ol
    commit-style = raw
    blame-separator-style = "#778595"
    hunk-header-decoration-style = "#c88e62" ul
    hunk-header-file-style = "#7b998a"
    hunk-header-line-number-style = "#6a8b7b"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#21222c"
    minus-non-emph-style = syntax "#21222c"
    minus-emph-style = syntax "#19214e"
    minus-empty-line-marker-style = syntax "#21222c"
    line-numbers-minus-style = "#bf687e"
    plus-style = syntax "#1c262e"
    plus-non-emph-style = syntax "#1c262e"
    plus-emph-style = syntax "#072a3b"
    plus-empty-line-marker-style = syntax "#1c262e"
    line-numbers-plus-style = "#7b998a"
    line-numbers-zero-style = "#bcbdbd"
    whitespace-error-style = "#8e78af"
    merge-conflict-ours-diff-header-style = "#bba76f" bold
    merge-conflict-theirs-diff-header-style = "#b19c63" bold overline
    map-styles = \
        bold purple => syntax "#121a24", \
        bold blue => syntax "#101822", \
        bold cyan => syntax "#161e28", \
        bold yellow => syntax "#18202a"