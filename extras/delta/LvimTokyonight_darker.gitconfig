[delta]
    syntax-theme = LvimTokyonight_darker
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#907bba"
    commit-decoration-style = "#826cb1" ol
    commit-style = raw
    blame-separator-style = "#7880a4"
    hunk-header-decoration-style = "#bb866d" ul
    hunk-header-file-style = "#788a67"
    hunk-header-line-number-style = "#73895e"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#252128"
    minus-non-emph-style = syntax "#252128"
    minus-emph-style = syntax "#341843"
    minus-empty-line-marker-style = syntax "#252128"
    line-numbers-minus-style = "#c46475"
    plus-style = syntax "#202428"
    plus-non-emph-style = syntax "#202428"
    plus-emph-style = syntax "#132836"
    plus-empty-line-marker-style = syntax "#202428"
    line-numbers-plus-style = "#788a67"
    line-numbers-zero-style = "#b2b6c7"
    whitespace-error-style = "#8a79a7"
    merge-conflict-ours-diff-header-style = "#b79d7b" bold
    merge-conflict-theirs-diff-header-style = "#ad9170" bold overline
    map-styles = \
        bold purple => syntax "#161920", \
        bold blue => syntax "#14171e", \
        bold cyan => syntax "#1a1d24", \
        bold yellow => syntax "#1c1f26"