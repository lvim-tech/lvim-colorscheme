[delta]
    syntax-theme = LvimCatppuccin_soft
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#b976a7"
    commit-decoration-style = "#a96b96" ol
    commit-style = raw
    blame-separator-style = "#8087a9"
    hunk-header-decoration-style = "#b88970" ul
    hunk-header-file-style = "#6e936c"
    hunk-header-line-number-style = "#669563"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#2e2833"
    minus-non-emph-style = syntax "#2e2833"
    minus-emph-style = syntax "#3f1d52"
    minus-empty-line-marker-style = syntax "#2e2833"
    line-numbers-minus-style = "#c46f84"
    plus-style = syntax "#282b32"
    plus-non-emph-style = syntax "#282b32"
    plus-emph-style = syntax "#1b2d4a"
    plus-empty-line-marker-style = syntax "#282b32"
    line-numbers-plus-style = "#6e936c"
    line-numbers-zero-style = "#b2b7c7"
    whitespace-error-style = "#9c7ebe"
    merge-conflict-ours-diff-header-style = "#b8a47e" bold
    merge-conflict-theirs-diff-header-style = "#af9973" bold overline
    map-styles = \
        bold purple => syntax "#20212b", \
        bold blue => syntax "#1e1f29", \
        bold cyan => syntax "#24252f", \
        bold yellow => syntax "#262731"