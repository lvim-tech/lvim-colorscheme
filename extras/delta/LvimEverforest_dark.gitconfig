[delta]
    syntax-theme = LvimEverforest_dark
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#c37960"
    commit-decoration-style = "#b3664c" ol
    commit-style = raw
    blame-separator-style = "#7c9370"
    hunk-header-decoration-style = "#cc7942" ul
    hunk-header-file-style = "#8f9330"
    hunk-header-line-number-style = "#8e9300"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#302c2c"
    minus-non-emph-style = syntax "#302c2c"
    minus-emph-style = syntax "#531d1d"
    minus-empty-line-marker-style = syntax "#302c2c"
    line-numbers-minus-style = "#e16666"
    plus-style = syntax "#2a2f2a"
    plus-non-emph-style = syntax "#2a2f2a"
    plus-emph-style = syntax "#193619"
    plus-empty-line-marker-style = syntax "#2a2f2a"
    line-numbers-plus-style = "#8f9330"
    line-numbers-zero-style = "#82907e"
    whitespace-error-style = "#918aa2"
    merge-conflict-ours-diff-header-style = "#af9e6b" bold
    merge-conflict-theirs-diff-header-style = "#a6935a" bold overline
    map-styles = \
        bold purple => syntax "#212626", \
        bold blue => syntax "#1f2424", \
        bold cyan => syntax "#252c2c", \
        bold yellow => syntax "#272e2e"