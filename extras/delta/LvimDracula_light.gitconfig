[delta]
    syntax-theme = LvimDracula_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#884f6e"
    commit-decoration-style = "#a65981" ol
    commit-style = raw
    blame-separator-style = "#5c6177"
    hunk-header-decoration-style = "#725e50" ul
    hunk-header-file-style = "#456a4d"
    hunk-header-line-number-style = "#49694e"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#e0d9d9"
    minus-non-emph-style = syntax "#e0d9d9"
    minus-emph-style = syntax "#f4d7d7"
    minus-empty-line-marker-style = syntax "#e0d9d9"
    line-numbers-minus-style = "#904f4f"
    plus-style = syntax "#d7dad8"
    plus-non-emph-style = syntax "#d7dad8"
    plus-emph-style = syntax "#9aeebc"
    plus-empty-line-marker-style = syntax "#d7dad8"
    line-numbers-plus-style = "#456a4d"
    line-numbers-zero-style = "#4e6767"
    whitespace-error-style = "#6b5c81"
    merge-conflict-ours-diff-header-style = "#61644b" bold
    merge-conflict-theirs-diff-header-style = "#61644b" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"