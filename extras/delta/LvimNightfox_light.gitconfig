[delta]
    syntax-theme = LvimNightfox_light
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#725884"
    commit-decoration-style = "#84679c" ol
    commit-style = raw
    blame-separator-style = "#5a626e"
    hunk-header-decoration-style = "#795c47" ul
    hunk-header-file-style = "#57665e"
    hunk-header-line-number-style = "#50685d"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#dfd9db"
    minus-non-emph-style = syntax "#dfd9db"
    minus-emph-style = syntax "#f3d6e0"
    minus-empty-line-marker-style = syntax "#dfd9db"
    line-numbers-minus-style = "#895260"
    plus-style = syntax "#dbdddc"
    plus-non-emph-style = syntax "#dbdddc"
    plus-emph-style = syntax "#9ff0cd"
    plus-empty-line-marker-style = syntax "#dbdddc"
    line-numbers-plus-style = "#57665e"
    line-numbers-zero-style = "#4e6767"
    whitespace-error-style = "#6d5a89"
    merge-conflict-ours-diff-header-style = "#6c6147" bold
    merge-conflict-theirs-diff-header-style = "#6c6146" bold overline
    map-styles = \
        bold purple => syntax "#dfdfdf", \
        bold blue => syntax "#dadada", \
        bold cyan => syntax "#e9e9e9", \
        bold yellow => syntax "#eeeeee"