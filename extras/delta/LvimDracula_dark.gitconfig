[delta]
    syntax-theme = LvimDracula_dark
    zero-style = syntax
    blame-code-style = syntax
    merge-conflict-ours-diff-header-decoration-style = ''
    merge-conflict-theirs-diff-header-decoration-style = ''

    file-style = omit "#c1729c"
    commit-decoration-style = "#b4618c" ol
    commit-style = raw
    blame-separator-style = "#848caa"
    hunk-header-decoration-style = "#b58f70" ul
    hunk-header-file-style = "#63996f"
    hunk-header-line-number-style = "#5f9a69"
    hunk-header-style = file line-number syntax bold italic
    minus-style = syntax "#302b34"
    minus-non-emph-style = syntax "#302b34"
    minus-emph-style = syntax "#422054"
    minus-empty-line-marker-style = syntax "#302b34"
    line-numbers-minus-style = "#cc7575"
    plus-style = syntax "#292f35"
    plus-non-emph-style = syntax "#292f35"
    plus-emph-style = syntax "#183346"
    plus-empty-line-marker-style = syntax "#292f35"
    line-numbers-plus-style = "#63996f"
    line-numbers-zero-style = "#c7c7b3"
    whitespace-error-style = "#9882b6"
    merge-conflict-ours-diff-header-style = "#adb27e" bold
    merge-conflict-theirs-diff-header-style = "#a3a975" bold overline
    map-styles = \
        bold purple => syntax "#22242e", \
        bold blue => syntax "#20222c", \
        bold cyan => syntax "#262832", \
        bold yellow => syntax "#282a34"