{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b2b7c7", "margin": 2 },
  "block_quote": { "color": "#d8b973", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b2b7c7", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#a183c5", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#0b0b12", "background_color": "#a183c5", "bold": true },
  "h2": { "prefix": "## ", "color": "#6793da" },
  "h3": { "prefix": "### ", "color": "#71becc" },
  "h4": { "prefix": "#### ", "color": "#7ac3b7" },
  "h5": { "prefix": "##### ", "color": "#84c27f" },
  "h6": { "prefix": "###### ", "color": "#6c7393", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#d8b973", "italic": true },
  "strong": { "color": "#da9366", "bold": true },
  "hr": { "color": "#2d2f3b", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#71becc", "underline": true },
  "link_text": { "color": "#d07fba", "bold": true },
  "image": { "color": "#71becc", "underline": true },
  "image_text": { "color": "#6c7393", "format": "Image: {{.text}} →" },
  "code": { "color": "#84c27f", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b2b7c7", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#6793da" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
