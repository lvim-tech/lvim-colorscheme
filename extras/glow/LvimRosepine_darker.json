{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b4b2c7", "margin": 2 },
  "block_quote": { "color": "#d6a765", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b4b2c7", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#958fa7", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#0a0910", "background_color": "#958fa7", "bold": true },
  "h2": { "prefix": "## ", "color": "#416d7f" },
  "h3": { "prefix": "### ", "color": "#83b2ba" },
  "h4": { "prefix": "#### ", "color": "#416d7f" },
  "h5": { "prefix": "##### ", "color": "#83b2ba" },
  "h6": { "prefix": "###### ", "color": "#746e91", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#d6a765", "italic": true },
  "strong": { "color": "#c68784", "bold": true },
  "hr": { "color": "#2f2c3c", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#83b2ba", "underline": true },
  "link_text": { "color": "#9f80c4", "bold": true },
  "image": { "color": "#83b2ba", "underline": true },
  "image_text": { "color": "#746e91", "format": "Image: {{.text}} →" },
  "code": { "color": "#83b2ba", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b4b2c7", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#416d7f" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
