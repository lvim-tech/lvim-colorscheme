{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b3afb2", "margin": 2 },
  "block_quote": { "color": "#b6a18b", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b3afb2", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#7f7c89", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#726f7c", "bold": true },
  "h2": { "prefix": "## ", "color": "#6c828c" },
  "h3": { "prefix": "### ", "color": "#788787" },
  "h4": { "prefix": "#### ", "color": "#69847b" },
  "h5": { "prefix": "##### ", "color": "#788b7c" },
  "h6": { "prefix": "###### ", "color": "#9a7292", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#b6a18b", "italic": true },
  "strong": { "color": "#a98a89", "bold": true },
  "hr": { "color": "#1b191d", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#788787", "underline": true },
  "link_text": { "color": "#9084a2", "bold": true },
  "image": { "color": "#788787", "underline": true },
  "image_text": { "color": "#9a7292", "format": "Image: {{.text}} →" },
  "code": { "color": "#788b7c", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b3afb2", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#6c828c" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
