{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#4e6767", "margin": 2 },
  "block_quote": { "color": "#696149", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#4e6767", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#635f6d", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#777283", "bold": true },
  "h2": { "prefix": "## ", "color": "#4b6575" },
  "h3": { "prefix": "### ", "color": "#4d6950" },
  "h4": { "prefix": "#### ", "color": "#45685f" },
  "h5": { "prefix": "##### ", "color": "#616342" },
  "h6": { "prefix": "###### ", "color": "#6a615a", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#696149", "italic": true },
  "strong": { "color": "#875537", "bold": true },
  "hr": { "color": "#eeeeee", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#4d6950", "underline": true },
  "link_text": { "color": "#895645", "bold": true },
  "image": { "color": "#4d6950", "underline": true },
  "image_text": { "color": "#6a615a", "format": "Image: {{.text}} →" },
  "code": { "color": "#616342", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#4e6767", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#4b6575" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
