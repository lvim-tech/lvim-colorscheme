{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#5e8888", "margin": 2 },
  "block_quote": { "color": "#edc060", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#5e8888", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#177ab3", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#181d1f", "background_color": "#177ab3", "bold": true },
  "h2": { "prefix": "## ", "color": "#0A85B9" },
  "h3": { "prefix": "### ", "color": "#018FA6" },
  "h4": { "prefix": "#### ", "color": "#218471" },
  "h5": { "prefix": "##### ", "color": "#8AA55F" },
  "h6": { "prefix": "###### ", "color": "#4d6263", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#edc060", "italic": true },
  "strong": { "color": "#FF9C2A", "bold": true },
  "hr": { "color": "#364149", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#018FA6", "underline": true },
  "link_text": { "color": "#c75940", "bold": true },
  "image": { "color": "#018FA6", "underline": true },
  "image_text": { "color": "#4d6263", "format": "Image: {{.text}} →" },
  "code": { "color": "#8AA55F", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#5e8888", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#0A85B9" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
