{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#c7c7b3", "margin": 2 },
  "block_quote": { "color": "#adb27e", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#c7c7b3", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#796496", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#20222c", "background_color": "#796496", "bold": true },
  "h2": { "prefix": "## ", "color": "#638993" },
  "h3": { "prefix": "### ", "color": "#66938a" },
  "h4": { "prefix": "#### ", "color": "#638e82" },
  "h5": { "prefix": "##### ", "color": "#62966d" },
  "h6": { "prefix": "###### ", "color": "#727a98", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#adb27e", "italic": true },
  "strong": { "color": "#b58f70", "bold": true },
  "hr": { "color": "#282a34", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#66938a", "underline": true },
  "link_text": { "color": "#bf6f9a", "bold": true },
  "image": { "color": "#66938a", "underline": true },
  "image_text": { "color": "#727a98", "format": "Image: {{.text}} →" },
  "code": { "color": "#62966d", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#c7c7b3", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#638993" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
