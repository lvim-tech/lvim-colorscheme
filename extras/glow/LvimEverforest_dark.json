{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#82907e", "margin": 2 },
  "block_quote": { "color": "#af9e6b", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#82907e", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#918aa2", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#635d71", "bold": true },
  "h2": { "prefix": "## ", "color": "#3a97bf" },
  "h3": { "prefix": "### ", "color": "#5d9a65" },
  "h4": { "prefix": "#### ", "color": "#1c9d88" },
  "h5": { "prefix": "##### ", "color": "#8f9330" },
  "h6": { "prefix": "###### ", "color": "#7c9370", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#af9e6b", "italic": true },
  "strong": { "color": "#cc7942", "bold": true },
  "hr": { "color": "#272e2e", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#5d9a65", "underline": true },
  "link_text": { "color": "#c37960", "bold": true },
  "image": { "color": "#5d9a65", "underline": true },
  "image_text": { "color": "#7c9370", "format": "Image: {{.text}} →" },
  "code": { "color": "#8f9330", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#82907e", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#3a97bf" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
