{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#5e8888", "margin": 2 },
  "block_quote": { "color": "#897a50", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#5e8888", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#8069a2", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#dadada", "background_color": "#8069a2", "bold": true },
  "h2": { "prefix": "## ", "color": "#546d8e" },
  "h3": { "prefix": "### ", "color": "#5b8e8f" },
  "h4": { "prefix": "#### ", "color": "#599181" },
  "h5": { "prefix": "##### ", "color": "#749182" },
  "h6": { "prefix": "###### ", "color": "#646f7d", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#897a50", "italic": true },
  "strong": { "color": "#ac7a53", "bold": true },
  "hr": { "color": "#eeeeee", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#5b8e8f", "underline": true },
  "link_text": { "color": "#755a88", "bold": true },
  "image": { "color": "#5b8e8f", "underline": true },
  "image_text": { "color": "#646f7d", "format": "Image: {{.text}} →" },
  "code": { "color": "#749182", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#5e8888", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#546d8e" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
