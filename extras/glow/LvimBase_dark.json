{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#629393", "margin": 2 },
  "block_quote": { "color": "#d8b36f", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#629393", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#3392d2", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#40719a", "bold": true },
  "h2": { "prefix": "## ", "color": "#3e92c5" },
  "h3": { "prefix": "### ", "color": "#4097aa" },
  "h4": { "prefix": "#### ", "color": "#3b9986" },
  "h5": { "prefix": "##### ", "color": "#7e965a" },
  "h6": { "prefix": "###### ", "color": "#659395", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#d8b36f", "italic": true },
  "strong": { "color": "#e19556", "bold": true },
  "hr": { "color": "#242b2f", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#4097aa", "underline": true },
  "link_text": { "color": "#de684e", "bold": true },
  "image": { "color": "#4097aa", "underline": true },
  "image_text": { "color": "#659395", "format": "Image: {{.text}} →" },
  "code": { "color": "#7e965a", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#629393", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#3e92c5" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
