{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#54546d", "margin": 2 },
  "block_quote": { "color": "#e0c286", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#54546d", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#766b90", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#1d1e22", "background_color": "#766b90", "bold": true },
  "h2": { "prefix": "## ", "color": "#4d699b" },
  "h3": { "prefix": "### ", "color": "#597b75" },
  "h4": { "prefix": "#### ", "color": "#4e8ca2" },
  "h5": { "prefix": "##### ", "color": "#6e8156" },
  "h6": { "prefix": "###### ", "color": "#4e4e73", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#e0c286", "italic": true },
  "strong": { "color": "#c99460", "bold": true },
  "hr": { "color": "#2f3038", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#597b75", "underline": true },
  "link_text": { "color": "#c4746e", "bold": true },
  "image": { "color": "#597b75", "underline": true },
  "image_text": { "color": "#4e4e73", "format": "Image: {{.text}} →" },
  "code": { "color": "#6e8156", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#54546d", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#4d699b" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
