{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b2c7c7", "margin": 2 },
  "block_quote": { "color": "#deb05c", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b2c7c7", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#9e86b0", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#1f282d", "background_color": "#9e86b0", "bold": true },
  "h2": { "prefix": "## ", "color": "#618adf" },
  "h3": { "prefix": "### ", "color": "#63bbdf" },
  "h4": { "prefix": "#### ", "color": "#5addbe" },
  "h5": { "prefix": "##### ", "color": "#a6c974" },
  "h6": { "prefix": "###### ", "color": "#5e6a70", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#deb05c", "italic": true },
  "strong": { "color": "#d77c61", "bold": true },
  "hr": { "color": "#36464e", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#63bbdf", "underline": true },
  "link_text": { "color": "#da596e", "bold": true },
  "image": { "color": "#63bbdf", "underline": true },
  "image_text": { "color": "#5e6a70", "format": "Image: {{.text}} →" },
  "code": { "color": "#a6c974", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b2c7c7", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#618adf" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
