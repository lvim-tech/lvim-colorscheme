{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#8585a4", "margin": 2 },
  "block_quote": { "color": "#d1b57c", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#8585a4", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#8c81a9", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#70658b", "bold": true },
  "h2": { "prefix": "## ", "color": "#5588d7" },
  "h3": { "prefix": "### ", "color": "#629189" },
  "h4": { "prefix": "#### ", "color": "#558ea4" },
  "h5": { "prefix": "##### ", "color": "#789059" },
  "h6": { "prefix": "###### ", "color": "#8383b4", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#d1b57c", "italic": true },
  "strong": { "color": "#bf8f62", "bold": true },
  "hr": { "color": "#24252b", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#629189", "underline": true },
  "link_text": { "color": "#c4726c", "bold": true },
  "image": { "color": "#629189", "underline": true },
  "image_text": { "color": "#8383b4", "format": "Image: {{.text}} →" },
  "code": { "color": "#789059", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#8585a4", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#5588d7" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
