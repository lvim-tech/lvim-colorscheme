{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#645c54", "margin": 2 },
  "block_quote": { "color": "#af9e6b", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#645c54", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#635d71", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#242322", "background_color": "#635d71", "bold": true },
  "h2": { "prefix": "## ", "color": "#497188" },
  "h3": { "prefix": "### ", "color": "#527a57" },
  "h4": { "prefix": "#### ", "color": "#43796d" },
  "h5": { "prefix": "##### ", "color": "#757845" },
  "h6": { "prefix": "###### ", "color": "#64584e", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#af9e6b", "italic": true },
  "strong": { "color": "#c47d54", "bold": true },
  "hr": { "color": "#2c2b2a", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#527a57", "underline": true },
  "link_text": { "color": "#bb755e", "bold": true },
  "image": { "color": "#527a57", "underline": true },
  "image_text": { "color": "#64584e", "format": "Image: {{.text}} →" },
  "code": { "color": "#757845", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#645c54", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#497188" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
