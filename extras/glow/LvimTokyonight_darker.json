{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b2b6c7", "margin": 2 },
  "block_quote": { "color": "#c5a06b", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b2b6c7", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#9381b3", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#0d0d11", "background_color": "#9381b3", "bold": true },
  "h2": { "prefix": "## ", "color": "#6589d7" },
  "h3": { "prefix": "### ", "color": "#60b0de" },
  "h4": { "prefix": "#### ", "color": "#36a08b" },
  "h5": { "prefix": "##### ", "color": "#9dbd7b" },
  "h6": { "prefix": "###### ", "color": "#616784", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#c5a06b", "italic": true },
  "strong": { "color": "#dd8b5a", "bold": true },
  "hr": { "color": "#232739", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#60b0de", "underline": true },
  "link_text": { "color": "#9470d5", "bold": true },
  "image": { "color": "#60b0de", "underline": true },
  "image_text": { "color": "#616784", "format": "Image: {{.text}} →" },
  "code": { "color": "#9dbd7b", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b2b6c7", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#6589d7" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
