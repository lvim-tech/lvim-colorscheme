{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b2b6c7", "margin": 2 },
  "block_quote": { "color": "#b79d7b", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b2b6c7", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#8a79a7", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#73638e", "bold": true },
  "h2": { "prefix": "## ", "color": "#6982bf" },
  "h3": { "prefix": "### ", "color": "#65859d" },
  "h4": { "prefix": "#### ", "color": "#5f8a80" },
  "h5": { "prefix": "##### ", "color": "#788a67" },
  "h6": { "prefix": "###### ", "color": "#7880a4", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#b79d7b", "italic": true },
  "strong": { "color": "#bb866d", "bold": true },
  "hr": { "color": "#1c1f26", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#65859d", "underline": true },
  "link_text": { "color": "#907bba", "bold": true },
  "image": { "color": "#65859d", "underline": true },
  "image_text": { "color": "#7880a4", "format": "Image: {{.text}} →" },
  "code": { "color": "#788a67", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b2b6c7", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#6982bf" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
