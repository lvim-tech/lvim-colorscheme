{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#9da4a4", "margin": 2 },
  "block_quote": { "color": "#96791f", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#9da4a4", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#8385a2", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#001f27", "background_color": "#8385a2", "bold": true },
  "h2": { "prefix": "## ", "color": "#4386b5" },
  "h3": { "prefix": "### ", "color": "#3e8d87" },
  "h4": { "prefix": "#### ", "color": "#3e8d87" },
  "h5": { "prefix": "##### ", "color": "#727f1a" },
  "h6": { "prefix": "###### ", "color": "#5d6a6f", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#96791f", "italic": true },
  "strong": { "color": "#ac5835", "bold": true },
  "hr": { "color": "#0e4b59", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#3e8d87", "underline": true },
  "link_text": { "color": "#b75283", "bold": true },
  "image": { "color": "#3e8d87", "underline": true },
  "image_text": { "color": "#5d6a6f", "format": "Image: {{.text}} →" },
  "code": { "color": "#727f1a", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#9da4a4", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#4386b5" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
