{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#9da4a4", "margin": 2 },
  "block_quote": { "color": "#a68a49", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#9da4a4", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#8789a9", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#727494", "bold": true },
  "h2": { "prefix": "## ", "color": "#5091c1" },
  "h3": { "prefix": "### ", "color": "#4b9a93" },
  "h4": { "prefix": "#### ", "color": "#499b7c" },
  "h5": { "prefix": "##### ", "color": "#859239" },
  "h6": { "prefix": "###### ", "color": "#788f97", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#a68a49", "italic": true },
  "strong": { "color": "#d47148", "bold": true },
  "hr": { "color": "#042f3a", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#4b9a93", "underline": true },
  "link_text": { "color": "#db649e", "bold": true },
  "image": { "color": "#4b9a93", "underline": true },
  "image_text": { "color": "#788f97", "format": "Image: {{.text}} →" },
  "code": { "color": "#859239", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#9da4a4", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#5091c1" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
