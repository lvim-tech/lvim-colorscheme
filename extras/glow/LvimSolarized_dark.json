{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#9da4a4", "margin": 2 },
  "block_quote": { "color": "#9f8549", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#9da4a4", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#757797", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#002732", "background_color": "#757797", "bold": true },
  "h2": { "prefix": "## ", "color": "#4f7ea3" },
  "h3": { "prefix": "### ", "color": "#4b8580" },
  "h4": { "prefix": "#### ", "color": "#49866e" },
  "h5": { "prefix": "##### ", "color": "#727c3e" },
  "h6": { "prefix": "###### ", "color": "#5d6a6f", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#9f8549", "italic": true },
  "strong": { "color": "#b46548", "bold": true },
  "hr": { "color": "#042f3a", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#4b8580", "underline": true },
  "link_text": { "color": "#c0578a", "bold": true },
  "image": { "color": "#4b8580", "underline": true },
  "image_text": { "color": "#5d6a6f", "format": "Image: {{.text}} →" },
  "code": { "color": "#727c3e", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#9da4a4", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#4f7ea3" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
