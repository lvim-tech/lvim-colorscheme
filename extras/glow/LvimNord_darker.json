{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b3bac6", "margin": 2 },
  "block_quote": { "color": "#cbae72", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b3bac6", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#9b93a4", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#14171c", "background_color": "#9b93a4", "bold": true },
  "h2": { "prefix": "## ", "color": "#8097af" },
  "h3": { "prefix": "### ", "color": "#7eaab7" },
  "h4": { "prefix": "#### ", "color": "#88aaa9" },
  "h5": { "prefix": "##### ", "color": "#97ab86" },
  "h6": { "prefix": "###### ", "color": "#677185", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#cbae72", "italic": true },
  "strong": { "color": "#ba8574", "bold": true },
  "hr": { "color": "#2c323d", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#7eaab7", "underline": true },
  "link_text": { "color": "#a58aa0", "bold": true },
  "image": { "color": "#7eaab7", "underline": true },
  "image_text": { "color": "#677185", "format": "Image: {{.text}} →" },
  "code": { "color": "#97ab86", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b3bac6", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#8097af" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
