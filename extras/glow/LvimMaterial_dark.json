{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b2c7c7", "margin": 2 },
  "block_quote": { "color": "#cfa96a", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b2c7c7", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#a186b5", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#876c9b", "bold": true },
  "h2": { "prefix": "## ", "color": "#6b8edd" },
  "h3": { "prefix": "### ", "color": "#65a1bd" },
  "h4": { "prefix": "#### ", "color": "#65b7a1" },
  "h5": { "prefix": "##### ", "color": "#90ad68" },
  "h6": { "prefix": "###### ", "color": "#7e949f", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#cfa96a", "italic": true },
  "strong": { "color": "#d37a60", "bold": true },
  "hr": { "color": "#263136", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#65a1bd", "underline": true },
  "link_text": { "color": "#df707f", "bold": true },
  "image": { "color": "#65a1bd", "underline": true },
  "image_text": { "color": "#7e949f", "format": "Image: {{.text}} →" },
  "code": { "color": "#90ad68", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b2c7c7", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#6b8edd" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
