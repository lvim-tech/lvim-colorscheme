{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#5e8888", "margin": 2 },
  "block_quote": { "color": "#8b6d37", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#5e8888", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#6f567f", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#dadada", "background_color": "#6f567f", "bold": true },
  "h2": { "prefix": "## ", "color": "#3c62a8" },
  "h3": { "prefix": "### ", "color": "#407e97" },
  "h4": { "prefix": "#### ", "color": "#2b7362" },
  "h5": { "prefix": "##### ", "color": "#5f7541" },
  "h6": { "prefix": "###### ", "color": "#798991", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#8b6d37", "italic": true },
  "strong": { "color": "#c77259", "bold": true },
  "hr": { "color": "#eeeeee", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#407e97", "underline": true },
  "link_text": { "color": "#b44356", "bold": true },
  "image": { "color": "#407e97", "underline": true },
  "image_text": { "color": "#798991", "format": "Image: {{.text}} →" },
  "code": { "color": "#5f7541", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#5e8888", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#3c62a8" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
