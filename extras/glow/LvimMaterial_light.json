{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#4e6767", "margin": 2 },
  "block_quote": { "color": "#746042", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#4e6767", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#6d597d", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#806594", "bold": true },
  "h2": { "prefix": "## ", "color": "#496095" },
  "h3": { "prefix": "### ", "color": "#4a6674" },
  "h4": { "prefix": "#### ", "color": "#446a5f" },
  "h5": { "prefix": "##### ", "color": "#596846" },
  "h6": { "prefix": "###### ", "color": "#5a6267", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#746042", "italic": true },
  "strong": { "color": "#86564a", "bold": true },
  "hr": { "color": "#eeeeee", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#4a6674", "underline": true },
  "link_text": { "color": "#a14351", "bold": true },
  "image": { "color": "#4a6674", "underline": true },
  "image_text": { "color": "#5a6267", "format": "Image: {{.text}} →" },
  "code": { "color": "#596846", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#4e6767", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#496095" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
