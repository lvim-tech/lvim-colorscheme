{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#9da4a4", "margin": 2 },
  "block_quote": { "color": "#9f8549", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#9da4a4", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#7f81a2", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#727494", "bold": true },
  "h2": { "prefix": "## ", "color": "#5089b4" },
  "h3": { "prefix": "### ", "color": "#4c8e88" },
  "h4": { "prefix": "#### ", "color": "#4a8f74" },
  "h5": { "prefix": "##### ", "color": "#7e8a3c" },
  "h6": { "prefix": "###### ", "color": "#72878e", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#9f8549", "italic": true },
  "strong": { "color": "#c16a49", "bold": true },
  "hr": { "color": "#04232b", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#4c8e88", "underline": true },
  "link_text": { "color": "#cf5a93", "bold": true },
  "image": { "color": "#4c8e88", "underline": true },
  "image_text": { "color": "#72878e", "format": "Image: {{.text}} →" },
  "code": { "color": "#7e8a3c", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#9da4a4", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#5089b4" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
