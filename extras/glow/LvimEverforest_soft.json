{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#869682", "margin": 2 },
  "block_quote": { "color": "#af9e6b", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#869682", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#938ca4", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#635d71", "bold": true },
  "h2": { "prefix": "## ", "color": "#379ac3" },
  "h3": { "prefix": "### ", "color": "#5ea067" },
  "h4": { "prefix": "#### ", "color": "#0ba38d" },
  "h5": { "prefix": "##### ", "color": "#92962d" },
  "h6": { "prefix": "###### ", "color": "#809873", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#af9e6b", "italic": true },
  "strong": { "color": "#d07b41", "bold": true },
  "hr": { "color": "#32393f", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#5ea067", "underline": true },
  "link_text": { "color": "#cc7d62", "bold": true },
  "image": { "color": "#5ea067", "underline": true },
  "image_text": { "color": "#809873", "format": "Image: {{.text}} →" },
  "code": { "color": "#92962d", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#869682", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#379ac3" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
