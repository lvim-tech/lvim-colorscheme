{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#c7c7b3", "margin": 2 },
  "block_quote": { "color": "#d0da68", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#c7c7b3", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#9c80c3", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#15161c", "background_color": "#9c80c3", "bold": true },
  "h2": { "prefix": "## ", "color": "#65c8dd" },
  "h3": { "prefix": "### ", "color": "#61dfca" },
  "h4": { "prefix": "#### ", "color": "#65c8dd" },
  "h5": { "prefix": "##### ", "color": "#58d879" },
  "h6": { "prefix": "###### ", "color": "#727a98", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#d0da68", "italic": true },
  "strong": { "color": "#de9f5c", "bold": true },
  "hr": { "color": "#2d2f3b", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#61dfca", "underline": true },
  "link_text": { "color": "#dc61a8", "bold": true },
  "image": { "color": "#61dfca", "underline": true },
  "image_text": { "color": "#727a98", "format": "Image: {{.text}} →" },
  "code": { "color": "#58d879", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#c7c7b3", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#65c8dd" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
