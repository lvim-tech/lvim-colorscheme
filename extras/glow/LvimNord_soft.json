{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b3bac6", "margin": 2 },
  "block_quote": { "color": "#c3a870", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b3bac6", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#978fa2", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#242934", "background_color": "#958ca0", "bold": true },
  "h2": { "prefix": "## ", "color": "#7c95af" },
  "h3": { "prefix": "### ", "color": "#719aa6" },
  "h4": { "prefix": "#### ", "color": "#789796" },
  "h5": { "prefix": "##### ", "color": "#879978" },
  "h6": { "prefix": "###### ", "color": "#8292b2", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#c3a870", "italic": true },
  "strong": { "color": "#bc8675", "bold": true },
  "hr": { "color": "#2c313c", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#719aa6", "underline": true },
  "link_text": { "color": "#a78ba2", "bold": true },
  "image": { "color": "#719aa6", "underline": true },
  "image_text": { "color": "#8292b2", "format": "Image: {{.text}} →" },
  "code": { "color": "#879978", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b3bac6", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#7c95af" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
