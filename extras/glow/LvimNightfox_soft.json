{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#bcbdbd", "margin": 2 },
  "block_quote": { "color": "#c1ac71", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#bcbdbd", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#9380b2", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#171f2b", "background_color": "#9380b2", "bold": true },
  "h2": { "prefix": "## ", "color": "#7292bd" },
  "h3": { "prefix": "### ", "color": "#75bbbd" },
  "h4": { "prefix": "#### ", "color": "#75bbbd" },
  "h5": { "prefix": "##### ", "color": "#89aa9a" },
  "h6": { "prefix": "###### ", "color": "#758292", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#c1ac71", "italic": true },
  "strong": { "color": "#d49360", "bold": true },
  "hr": { "color": "#2d3e56", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#75bbbd", "underline": true },
  "link_text": { "color": "#9b82af", "bold": true },
  "image": { "color": "#75bbbd", "underline": true },
  "image_text": { "color": "#758292", "format": "Image: {{.text}} →" },
  "code": { "color": "#89aa9a", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#bcbdbd", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#7292bd" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
