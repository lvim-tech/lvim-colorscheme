{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#bcbdbd", "margin": 2 },
  "block_quote": { "color": "#bba76f", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#bcbdbd", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#9882b9", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#816ba1", "bold": true },
  "h2": { "prefix": "## ", "color": "#6e90bd" },
  "h3": { "prefix": "### ", "color": "#69a3a4" },
  "h4": { "prefix": "#### ", "color": "#66a492" },
  "h5": { "prefix": "##### ", "color": "#7b998a" },
  "h6": { "prefix": "###### ", "color": "#808fa2", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#bba76f", "italic": true },
  "strong": { "color": "#c88e62", "bold": true },
  "hr": { "color": "#212c3b", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#69a3a4", "underline": true },
  "link_text": { "color": "#9d83b0", "bold": true },
  "image": { "color": "#69a3a4", "underline": true },
  "image_text": { "color": "#808fa2", "format": "Image: {{.text}} →" },
  "code": { "color": "#7b998a", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#bcbdbd", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#6e90bd" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
