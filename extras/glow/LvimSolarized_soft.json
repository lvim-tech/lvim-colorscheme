{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#9da4a4", "margin": 2 },
  "block_quote": { "color": "#b09148", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#9da4a4", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#9293b3", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#727494", "bold": true },
  "h2": { "prefix": "## ", "color": "#4f9dd2" },
  "h3": { "prefix": "### ", "color": "#4aa39c" },
  "h4": { "prefix": "#### ", "color": "#48a482" },
  "h5": { "prefix": "##### ", "color": "#8f9d33" },
  "h6": { "prefix": "###### ", "color": "#809aa4", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#b09148", "italic": true },
  "strong": { "color": "#e27647", "bold": true },
  "hr": { "color": "#043845", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#4aa39c", "underline": true },
  "link_text": { "color": "#e06fa5", "bold": true },
  "image": { "color": "#4aa39c", "underline": true },
  "image_text": { "color": "#809aa4", "format": "Image: {{.text}} →" },
  "code": { "color": "#8f9d33", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#9da4a4", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#4f9dd2" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
