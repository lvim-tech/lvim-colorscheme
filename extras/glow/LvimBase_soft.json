{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#659c9c", "margin": 2 },
  "block_quote": { "color": "#d8b36f", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#659c9c", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#2c98dc", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#40719a", "bold": true },
  "h2": { "prefix": "## ", "color": "#399bd3" },
  "h3": { "prefix": "### ", "color": "#3e9db1" },
  "h4": { "prefix": "#### ", "color": "#36a28d" },
  "h5": { "prefix": "##### ", "color": "#80995b" },
  "h6": { "prefix": "###### ", "color": "#68999b", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#d8b36f", "italic": true },
  "strong": { "color": "#e19556", "bold": true },
  "hr": { "color": "#2a3135", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#3e9db1", "underline": true },
  "link_text": { "color": "#e86b50", "bold": true },
  "image": { "color": "#3e9db1", "underline": true },
  "image_text": { "color": "#68999b", "format": "Image: {{.text}} →" },
  "code": { "color": "#80995b", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#659c9c", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#399bd3" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
