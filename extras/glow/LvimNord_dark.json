{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b3bac6", "margin": 2 },
  "block_quote": { "color": "#c3a870", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b3bac6", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#887f93", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#1f242d", "background_color": "#887f93", "bold": true },
  "h2": { "prefix": "## ", "color": "#73889e" },
  "h3": { "prefix": "### ", "color": "#7097a3" },
  "h4": { "prefix": "#### ", "color": "#789796" },
  "h5": { "prefix": "##### ", "color": "#879978" },
  "h6": { "prefix": "###### ", "color": "#677185", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#c3a870", "italic": true },
  "strong": { "color": "#b88473", "bold": true },
  "hr": { "color": "#272c35", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#7097a3", "underline": true },
  "link_text": { "color": "#a2869d", "bold": true },
  "image": { "color": "#7097a3", "underline": true },
  "image_text": { "color": "#677185", "format": "Image: {{.text}} →" },
  "code": { "color": "#879978", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b3bac6", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#73889e" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
