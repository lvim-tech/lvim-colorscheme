{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#b2b7c7", "margin": 2 },
  "block_quote": { "color": "#b8a47e", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#b2b7c7", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#7c609b", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#1e1f29", "background_color": "#7c609b", "bold": true },
  "h2": { "prefix": "## ", "color": "#6076a0" },
  "h3": { "prefix": "### ", "color": "#65878e" },
  "h4": { "prefix": "#### ", "color": "#658882" },
  "h5": { "prefix": "##### ", "color": "#6b8d69" },
  "h6": { "prefix": "###### ", "color": "#6c7393", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#b8a47e", "italic": true },
  "strong": { "color": "#b88970", "bold": true },
  "hr": { "color": "#262731", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#65878e", "underline": true },
  "link_text": { "color": "#b976a7", "bold": true },
  "image": { "color": "#65878e", "underline": true },
  "image_text": { "color": "#6c7393", "format": "Image: {{.text}} →" },
  "code": { "color": "#6b8d69", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#b2b7c7", "margin": 2, "theme": "nord" },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#6076a0" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
