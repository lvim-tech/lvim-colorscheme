{
  "manifest_version": 2,
  "name": "Lvim Colorscheme SolarizedDark",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-solarized-dark@lvim-tech" } },
  "theme": {
    "colors": {
      "frame": "#002732",
      "frame_inactive": "#002934",
      "tab_background_text": "#6f7f84",
      "tab_selected": "#042f3a",
      "tab_text": "#969e9e",
      "tab_background_separator": "#002934",
      "tab_line": "#4f7ea3",
      "tab_loading": "#4f7ea3",
      "toolbar": "#002b36",
      "toolbar_text": "#969e9e",
      "bookmark_text": "#969e9e",
      "toolbar_field": "#002732",
      "toolbar_field_text": "#969e9e",
      "toolbar_field_border": "#002934",
      "toolbar_field_focus": "#002934",
      "toolbar_field_text_focus": "#969e9e",
      "toolbar_field_border_focus": "#4f7ea3",
      "toolbar_field_highlight": "#4f7ea3",
      "toolbar_top_separator": "#002732",
      "toolbar_bottom_separator": "#002934",
      "toolbar_vertical_separator": "#002934",
      "button_background_hover": "#022d38",
      "button_background_active": "#042f3a",
      "popup": "#002732",
      "popup_text": "#969e9e",
      "popup_border": "#002934",
      "popup_highlight": "#042f3a",
      "popup_highlight_text": "#969e9e",
      "ntp_background": "#002b36",
      "ntp_text": "#969e9e",
      "sidebar": "#002732",
      "sidebar_text": "#969e9e",
      "sidebar_border": "#002934",
      "sidebar_highlight": "#4f7ea3",
      "sidebar_highlight_text": "#002732",
      "icons": "#969e9e",
      "icons_attention": "#727c3e"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
