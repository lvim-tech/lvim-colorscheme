      "popup": "#252732",
      "popup_text": "#c2c2b7",
      "popup_border": "#272934",
      "popup_highlight": "#2d2f3a",
      "popup_highlight_text": "#c2c2b7",
      "ntp_background": "#292b36",
      "ntp_text": "#c2c2b7",
      "sidebar": "#252732",
      "sidebar_text": "#c2c2b7",
      "sidebar_border": "#272934",
      "sidebar_highlight": "#638993",
      "sidebar_highlight_text": "#252732",
      "icons": "#c2c2b7",
      "icons_attention": "#62966d"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
