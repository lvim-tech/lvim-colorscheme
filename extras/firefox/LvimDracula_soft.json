{
  "manifest_version": 2,
  "name": "Lvim Colorscheme DraculaSoft",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-dracula-soft@lvim-tech" } },
  "theme": {
    "colors": {
      "frame": "#252732",
      "frame_inactive": "#272934",
      "tab_background_text": "#727a98",
      "tab_selected": "#2d2f3a",
      "tab_text": "#c2c2b7",
      "tab_background_separator": "#272934",
      "tab_line": "#638993",
      "tab_loading": "#638993",
      "toolbar": "#292b36",
      "toolbar_text": "#c2c2b7",
      "bookmark_text": "#c2c2b7",
      "toolbar_field": "#252732",
      "toolbar_field_text": "#c2c2b7",
      "toolbar_field_border": "#272934",
      "toolbar_field_focus": "#272934",
      "toolbar_field_text_focus": "#c2c2b7",
      "toolbar_field_border_focus": "#638993",
      "toolbar_field_highlight": "#638993",
      "toolbar_top_separator": "#252732",
      "toolbar_bottom_separator": "#272934",
      "toolbar_vertical_separator": "#272934",
      "button_background_hover": "#2b2d38",
