{
  "manifest_version": 2,
  "name": "Lvim Colorscheme RosepineSoft",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-rosepine-soft@lvim-tech" } },
  "theme": {
    "colors": {
      "frame": "#1f1d22",
      "frame_inactive": "#211f24",
      "tab_background_text": "#896882",
      "tab_selected": "#27252a",
      "tab_text": "#b9b4b5",
      "tab_background_separator": "#211f24",
      "tab_line": "#5d6d74",
      "tab_loading": "#5d6d74",
      "toolbar": "#232126",
      "toolbar_text": "#b9b4b5",
      "bookmark_text": "#b9b4b5",
      "toolbar_field": "#1f1d22",
      "toolbar_field_text": "#b9b4b5",
      "toolbar_field_border": "#211f24",
      "toolbar_field_focus": "#211f24",
      "toolbar_field_text_focus": "#b9b4b5",
