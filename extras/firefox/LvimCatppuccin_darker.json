{
  "manifest_version": 2,
  "name": "Lvim Colorscheme CatppuccinDarker",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-catppuccin-darker@lvim-tech" } },
