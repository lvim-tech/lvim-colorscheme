{
  "manifest_version": 2,
  "name": "Lvim Colorscheme NordSoft",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-nord-soft@lvim-tech" } },
  "theme": {
    "colors": {
      "frame": "#242934",
      "frame_inactive": "#262b36",
      "tab_background_text": "#697488",
      "tab_selected": "#2c313c",
      "tab_text": "#b4bac6",
      "tab_background_separator": "#262b36",
      "tab_line": "#73889e",
      "tab_loading": "#73889e",
      "toolbar": "#282d38",
      "toolbar_text": "#b4bac6",
      "bookmark_text": "#b4bac6",
