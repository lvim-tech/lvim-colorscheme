{
  "manifest_version": 2,
  "name": "Lvim Colorscheme TokyonightDark",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-tokyonight-dark@lvim-tech" } },
