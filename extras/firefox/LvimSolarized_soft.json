      "popup_highlight_text": "#969e9e",
      "ntp_background": "#003441",
      "ntp_text": "#969e9e",
      "sidebar": "#00303d",
      "sidebar_text": "#969e9e",
      "sidebar_border": "#00323f",
      "sidebar_highlight": "#4f7ea3",
      "sidebar_highlight_text": "#00303d",
      "icons": "#969e9e",
      "icons_attention": "#727c3e"
