{
  "manifest_version": 2,
  "name": "Lvim Colorscheme SolarizedSoft",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-solarized-soft@lvim-tech" } },
  "theme": {
    "colors": {
      "frame": "#00303d",
      "frame_inactive": "#00323f",
      "tab_background_text": "#6f7f84",
      "tab_selected": "#043845",
      "tab_text": "#969e9e",
      "tab_background_separator": "#00323f",
      "tab_line": "#4f7ea3",
      "tab_loading": "#4f7ea3",
      "toolbar": "#003441",
      "toolbar_text": "#969e9e",
      "bookmark_text": "#969e9e",
      "toolbar_field": "#00303d",
      "toolbar_field_text": "#969e9e",
      "toolbar_field_border": "#00323f",
      "toolbar_field_focus": "#00323f",
      "toolbar_field_text_focus": "#969e9e",
      "toolbar_field_border_focus": "#4f7ea3",
      "toolbar_field_highlight": "#4f7ea3",
      "toolbar_top_separator": "#00303d",
      "toolbar_bottom_separator": "#00323f",
      "toolbar_vertical_separator": "#00323f",
