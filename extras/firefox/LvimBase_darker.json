{
  "manifest_version": 2,
  "name": "Lvim Colorscheme BaseDarker",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-base-darker@lvim-tech" } },
  "theme": {
    "colors": {
      "frame": "#181e21",
      "frame_inactive": "#1a2023",
      "tab_background_text": "#536d6e",
      "tab_selected": "#202629",
      "tab_text": "#55a6ab",
      "tab_background_separator": "#1a2023",
      "tab_line": "#447ca2",
      "tab_loading": "#447ca2",
      "toolbar": "#1c2225",
      "toolbar_text": "#55a6ab",
      "bookmark_text": "#55a6ab",
      "toolbar_field": "#181e21",
      "toolbar_field_text": "#55a6ab",
      "toolbar_field_border": "#1a2023",
      "toolbar_field_focus": "#1a2023",
      "toolbar_field_text_focus": "#55a6ab",
      "toolbar_field_border_focus": "#447ca2",
      "toolbar_field_highlight": "#447ca2",
      "toolbar_top_separator": "#181e21",
      "toolbar_bottom_separator": "#1a2023",
