{
  "manifest_version": 2,
  "name": "Lvim Colorscheme MaterialSoft",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-material-soft@lvim-tech" } },
  "theme": {
    "colors": {
      "frame": "#232f35",
      "frame_inactive": "#253137",
      "tab_background_text": "#6a7981",
      "tab_selected": "#2b373d",
      "tab_text": "#b8bec2",
      "tab_background_separator": "#253137",
      "tab_line": "#5b7fcb",
      "tab_loading": "#5b7fcb",
      "toolbar": "#273339",
      "toolbar_text": "#b8bec2",
      "bookmark_text": "#b8bec2",
      "toolbar_field": "#232f35",
      "toolbar_field_text": "#b8bec2",
      "toolbar_field_border": "#253137",
      "toolbar_field_focus": "#253137",
      "toolbar_field_text_focus": "#b8bec2",
      "toolbar_field_border_focus": "#5b7fcb",
      "toolbar_field_highlight": "#5b7fcb",
      "toolbar_top_separator": "#232f35",
      "toolbar_bottom_separator": "#253137",
      "toolbar_vertical_separator": "#253137",
      "button_background_hover": "#29353b",
      "button_background_active": "#2b373d",
      "popup": "#232f35",
      "popup_text": "#b8bec2",
      "popup_border": "#253137",
      "popup_highlight": "#2b373d",
      "popup_highlight_text": "#b8bec2",
      "ntp_background": "#273339",
      "ntp_text": "#b8bec2",
      "sidebar": "#232f35",
      "sidebar_text": "#b8bec2",
      "sidebar_border": "#253137",
      "sidebar_highlight": "#5b7fcb",
      "sidebar_highlight_text": "#232f35",
      "icons": "#b8bec2",
      "icons_attention": "#90ad68"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
