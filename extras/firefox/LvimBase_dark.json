      "popup": "#1c2327",
      "popup_text": "#55a6ab",
      "popup_border": "#1e2529",
      "popup_highlight": "#242b2f",
      "popup_highlight_text": "#55a6ab",
      "ntp_background": "#20272b",
      "ntp_text": "#55a6ab",
      "sidebar": "#1c2327",
      "sidebar_text": "#55a6ab",
      "sidebar_border": "#1e2529",
      "sidebar_highlight": "#447ca2",
      "sidebar_highlight_text": "#1c2327",
      "icons": "#55a6ab",
      "icons_attention": "#7e965a"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
