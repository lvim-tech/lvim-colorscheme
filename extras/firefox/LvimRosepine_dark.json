{
  "manifest_version": 2,
  "name": "Lvim Colorscheme RosepineDark",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-rosepine-dark@lvim-tech" } },
  "theme": {
    "colors": {
      "frame": "#19171b",
      "frame_inactive": "#1b191d",
      "tab_background_text": "#896882",
      "tab_selected": "#211f23",
      "tab_text": "#b9b4b5",
      "tab_background_separator": "#1b191d",
      "tab_line": "#5d6d74",
      "tab_loading": "#5d6d74",
      "toolbar": "#1d1b1f",
      "toolbar_text": "#b9b4b5",
      "bookmark_text": "#b9b4b5",
      "toolbar_field": "#19171b",
      "toolbar_field_text": "#b9b4b5",
      "toolbar_field_border": "#1b191d",
      "toolbar_field_focus": "#1b191d",
      "toolbar_field_text_focus": "#b9b4b5",
      "toolbar_field_border_focus": "#5d6d74",
      "toolbar_field_highlight": "#5d6d74",
      "toolbar_top_separator": "#19171b",
      "toolbar_bottom_separator": "#1b191d",
      "toolbar_vertical_separator": "#1b191d",
