      "popup": "#19171b",
      "popup_text": "#b9b4b5",
      "popup_border": "#1b191d",
      "popup_highlight": "#211f23",
      "popup_highlight_text": "#b9b4b5",
      "ntp_background": "#1d1b1f",
      "ntp_text": "#b9b4b5",
      "sidebar": "#19171b",
      "sidebar_text": "#b9b4b5",
      "sidebar_border": "#1b191d",
      "sidebar_highlight": "#5d6d74",
      "sidebar_highlight_text": "#19171b",
      "icons": "#b9b4b5",
      "icons_attention": "#788b7c"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
