{
  "manifest_version": 2,
  "name": "Lvim Colorscheme TokyonightSoft",
  "version": "1.0.0",
  "author": "lvim-tech",
  "browser_specific_settings": { "gecko": { "id": "lvim-tokyonight-soft@lvim-tech" } },
  "theme": {
    "colors": {
      "frame": "#1e212a",
      "frame_inactive": "#20232c",
      "tab_background_text": "#6a7190",
      "tab_selected": "#262932",
      "tab_text": "#b5b9ca",
      "tab_background_separator": "#20232c",
      "tab_line": "#6073a4",
      "tab_loading": "#6073a4",
      "toolbar": "#22252e",
      "toolbar_text": "#b5b9ca",
      "bookmark_text": "#b5b9ca",
      "toolbar_field": "#1e212a",
      "toolbar_field_text": "#b5b9ca",
      "toolbar_field_border": "#20232c",
      "toolbar_field_focus": "#20232c",
      "toolbar_field_text_focus": "#b5b9ca",
      "toolbar_field_border_focus": "#6073a4",
      "toolbar_field_highlight": "#6073a4",
      "toolbar_top_separator": "#1e212a",
      "toolbar_bottom_separator": "#20232c",
      "toolbar_vertical_separator": "#20232c",
      "button_background_hover": "#242730",
