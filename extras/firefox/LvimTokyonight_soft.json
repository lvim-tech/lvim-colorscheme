      "popup": "#1e212a",
      "popup_text": "#b5b9ca",
      "popup_border": "#20232c",
      "popup_highlight": "#262932",
      "popup_highlight_text": "#b5b9ca",
      "ntp_background": "#22252e",
      "ntp_text": "#b5b9ca",
      "sidebar": "#1e212a",
      "sidebar_text": "#b5b9ca",
      "sidebar_border": "#20232c",
      "sidebar_highlight": "#6073a4",
      "sidebar_highlight_text": "#1e212a",
      "icons": "#b5b9ca",
      "icons_attention": "#788a67"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
