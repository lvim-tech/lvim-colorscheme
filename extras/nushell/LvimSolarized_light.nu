        shape_signature: { fg: "#707c19" attr: "b" }
        shape_string: "#707c19"
        shape_string_interpolation: { fg: "#347873" attr: "b" }
        shape_table: { fg: "#39739c" attr: "b" }
        shape_variable: "#626587"
        shape_vardecl: "#626587"
    }
