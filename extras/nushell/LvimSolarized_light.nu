# Lvim Colorscheme SolarizedLight
export def main [] {
    return {
        separator: "#eeeeee"
        leading_trailing_space_bg: { attr: "n" }
        header: { fg: "#707c19" attr: "b" }
        empty: "#39739c"
        bool: "#347873"
        int: "#626587"
        filesize: "#347873"
        duration: "#5e8888"
        date: "#bd5588"
