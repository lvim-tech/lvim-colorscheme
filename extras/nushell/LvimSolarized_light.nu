        search_result: { fg: "#ca5350" bg: "#5e8888" }

        shape_and: { fg: "#707293" attr: "b" }
        shape_binary: { fg: "#707293" attr: "b" }
        shape_block: { fg: "#4c799d" attr: "b" }
        shape_bool: "#467c77"
        shape_closure: { fg: "#727c3e" attr: "b" }
