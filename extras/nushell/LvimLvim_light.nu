        shape_filepath: "#01778a"
        shape_flag: { fg: "#0879a9" attr: "b" }
        shape_float: { fg: "#1981bd" attr: "b" }
        shape_garbage: { fg: "#55a6ab" bg: "#ac4135" attr: "b" }
